        // HESAP SİLME (DANGER ZONE) ETKİLEŞİMİ
        // ==========================================
        const deleteAccountBtn = document.getElementById('deleteAccountBtn');
        const accountDeleteConfirmOverlay = document.getElementById('accountDeleteConfirmOverlay');
        const accountDeleteCancelBtn = document.getElementById('accountDeleteCancelBtn');
        const accountDeleteConfirmBtn = document.getElementById('accountDeleteConfirmBtn');

        if (deleteAccountBtn && accountDeleteConfirmOverlay) {
            deleteAccountBtn.addEventListener('click', function() {
                accountDeleteConfirmOverlay.classList.add('active');
            });
        }

        if (accountDeleteCancelBtn && accountDeleteConfirmOverlay) {
            accountDeleteCancelBtn.addEventListener('click', function() {
                accountDeleteConfirmOverlay.classList.remove('active');
            });
        }

        if (accountDeleteConfirmOverlay) {
            accountDeleteConfirmOverlay.addEventListener('click', function(e) {
                if (e.target === accountDeleteConfirmOverlay) {
                    accountDeleteConfirmOverlay.classList.remove('active');
                }
            });
        }

        if (accountDeleteConfirmBtn) {
            accountDeleteConfirmBtn.addEventListener('click', async function() {
                try {
                    accountDeleteConfirmBtn.disabled = true;
                    accountDeleteConfirmBtn.textContent = 'Siliniyor...';

                    const response = await fetch('/user/account', {
                        method: 'DELETE'
                    });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        window.location.href = data.redirect || '/signin';
                    } else {
                        alert(data.error || 'Hesap silinemedi.');
                        accountDeleteConfirmBtn.disabled = false;
                        accountDeleteConfirmBtn.textContent = '<%= t("chat.yes_delete_account") %>';
                    }
                } catch (err) {
                    console.error('Hesap silme hatası:', err);
                    alert('Bağlantı hatası oluştu.');
                    accountDeleteConfirmBtn.disabled = false;
                    accountDeleteConfirmBtn.textContent = '<%= t("chat.yes_delete_account") %>';
