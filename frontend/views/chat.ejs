        // ==========================================
        // İSTEMCİ TARAFI DİL ÇEVİRİLERİ (I18N)
        // ==========================================
        const I18N = {
            today: "<%= t('chat.today') %>",
            yesterday: "<%= t('chat.yesterday') %>",
            thisWeek: "<%= t('chat.this_week') %>",
            older: "<%= t('chat.older') %>",
            pinned: "<%= t('chat.pinned') %>",
            pinChat: "<%= t('chat.pin_chat') %>",
            unpinChat: "<%= t('chat.unpin_chat') %>",
            pinRecipe: "<%= t('chat.pin_recipe') %>",
            unpinRecipe: "<%= t('chat.unpin_recipe') %>",
            rename: "<%= t('chat.rename') %>",
            delete: "<%= t('chat.delete') %>",
            deleteRecipe: "<%= t('chat.delete_recipe') %>",
            searchPlaceholderChats: "<%= t('chat.search_placeholder_chats') %>",
            searchPlaceholderRecipes: "<%= t('chat.search_placeholder_recipes') %>",
            emptyChats: "<%= t('chat.empty_chats') %>",
            notFoundChats: "<%= t('chat.not_found_chats') %>",
            emptyRecipes: "<%= t('chat.empty_recipes') %>",
            notFoundRecipes: "<%= t('chat.not_found_recipes') %>",
            jumpToChat: "<%= t('chat.jump_to_chat') %>",
            recipe: "<%= t('chat.recipe') %>",
            nutritionSummary: "<%= t('chat.nutrition_summary') %>",
            confirmDeleteChat: "<%= t('chat.confirm_delete_chat') %>",
            confirmDeleteRecipe: "<%= t('chat.confirm_delete_recipe') %>",
            thinking: "<%= t('chat.thinking') %>",
            recipeDefault: "<%= t('chat.recipe_default') %>",
            portion: "<%= t('chat.portion') %>",
            options: "<%= t('chat.options') %>"
        };

        // ==========================================
        // SOHBET OTURUMLARI (CONVERSATION) YÖNETİMİ
        // ==========================================
        const chatHistorySection = document.getElementById('chatHistorySection');
        const searchInput = document.getElementById('searchInput');
        let allChatSessions = []; // Backend'den gelen konuşmalar [{ id, title, created_at, updated_at, is_pinned }]
        let activeConversationId = null;

        // Tarih formatlama yardımcısı (Bugün, Dün, Bu Hafta, Daha Eski)
        function getDateCategory(timestampSeconds) {
            if (!timestampSeconds) return I18N.older;
            const date = new Date(timestampSeconds * 1000);
            const now = new Date();
            
            const isToday = date.toDateString() === now.toDateString();
            if (isToday) return I18N.today;

            const yesterday = new Date();
            yesterday.setDate(now.getDate() - 1);
            if (date.toDateString() === yesterday.toDateString()) return I18N.yesterday;

            const sevenDaysAgo = new Date();
            sevenDaysAgo.setDate(now.getDate() - 7);
            if (date > sevenDaysAgo) return I18N.thisWeek;

            return I18N.older;
        }

        // Sidebar'da Grupları Render Etme (Sabitlenenler en üstte, diğerleri tarih gruplarında)
        function renderSidebarHistory(filterQuery = '') {
            if (!chatHistorySection) return;
            chatHistorySection.innerHTML = '';

            const q = filterQuery.toLowerCase().trim();

            const filteredSessions = q
                ? allChatSessions.filter(s => (s.title || '').toLowerCase().includes(q))
                : allChatSessions;

            if (allChatSessions.length === 0) {
                chatHistorySection.innerHTML = `
                    <div class="historyEmptyState">
                        <span class="emptyIcon">🥑</span>
                        ${I18N.emptyChats}
                    </div>
                `;
                return;
            }

            if (filteredSessions.length === 0) {
                chatHistorySection.innerHTML = `
                    <div class="historyNotFound">
                        "${escapeHtml(filterQuery)}" ${I18N.notFoundChats}
                    </div>
                `;
                return;
            }

            // Sabitlenenleri ve normal kategorileri ayrıştır
            const pinnedSessions = filteredSessions.filter(s => s.is_pinned === 1 || s.is_pinned === true);
            const regularSessions = filteredSessions.filter(s => !(s.is_pinned === 1 || s.is_pinned === true));

            // 1. Varsa Sabitlenenler Grubu Render Et
            if (pinnedSessions.length > 0) {
                renderGroupCategory("📌 " + I18N.pinned, pinnedSessions);
            }

            // 2. Normal Tarih Gruplarını Render Et (Bugün, Dün, Bu Hafta, Daha Eski)
            const categories = {};
            regularSessions.forEach(sess => {
                const cat = sess.category || getDateCategory(sess.updated_at);
                if (!categories[cat]) {
                    categories[cat] = [];
                }
                categories[cat].push(sess);
            });

            // Bilinen sıralama düzeni
            const categoryOrder = [I18N.today, I18N.yesterday, I18N.thisWeek, I18N.older];
            categoryOrder.forEach(catName => {
                if (categories[catName] && categories[catName].length > 0) {
                    renderGroupCategory(catName, categories[catName]);
                }
            });

            // Listede olmayan başka bir kategori varsa ekle
            Object.keys(categories).forEach(catName => {
                if (!categoryOrder.includes(catName) && categories[catName].length > 0) {
                    renderGroupCategory(catName, categories[catName]);
                }
            });
        }

        // Tek bir kategori grubunu oluşturan yardımcı fonksiyon
        function renderGroupCategory(groupTitleText, sessionList) {
            const groupDiv = document.createElement('div');
            groupDiv.className = 'historyGroup';

            const titleDiv = document.createElement('div');
            titleDiv.className = 'groupTitle';
            titleDiv.textContent = groupTitleText;
            groupDiv.appendChild(titleDiv);

            sessionList.forEach(sess => {
                const isPinned = sess.is_pinned === 1 || sess.is_pinned === true;
                const itemDiv = document.createElement('div');
                itemDiv.className = 'historyItem';
                if (activeConversationId === sess.id) {
                    itemDiv.classList.add('active');
                }
                itemDiv.dataset.sessionId = sess.id;
                itemDiv.title = sess.title;

                itemDiv.innerHTML = `
                    <div class="historyItemLeft">
                        <span class="historyDot"></span>
                        ${isPinned ? '<span class="historyPinIcon" title="' + I18N.pinned + '">📌</span>' : ''}
                        <span class="historyTitle">${escapeHtml(sess.title)}</span>
                    </div>
                    <button type="button" class="historyItemMoreBtn" title="${I18N.options}" aria-label="${I18N.options}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <circle cx="12" cy="5" r="2"></circle>
                            <circle cx="12" cy="12" r="2"></circle>
                            <circle cx="12" cy="19" r="2"></circle>
                        </svg>
                    </button>
                    <div class="historyDropdownMenu">
                        <button type="button" class="dropdownActionItem actionPin">
                            <span class="dropdownActionIcon">${isPinned ? '📍' : '📌'}</span>
                            <span>${isPinned ? I18N.unpinChat : I18N.pinChat}</span>
                        </button>
                        <button type="button" class="dropdownActionItem actionRename">
                            <span class="dropdownActionIcon">✏️</span>
                            <span>${I18N.rename}</span>
                        </button>
                        <button type="button" class="dropdownActionItem danger actionDelete">
                            <span class="dropdownActionIcon">🗑️</span>
                            <span>${I18N.delete}</span>
                        </button>
                    </div>
                `;

                // Sohbete Tıklayınca Mesajları Yükleme
                itemDiv.addEventListener('click', (e) => {
                    // Eğer 3 nokta butonuna veya dropdown menüsüne tıklandıysa sohbet yükleme tetiklenmesin
                    if (e.target.closest('.historyItemMoreBtn') || e.target.closest('.historyDropdownMenu')) {
                        return;
                    }
                    loadConversationToChat(sess, itemDiv);
                });

                // 3 Nokta Butonu Etkileşimi
                const moreBtn = itemDiv.querySelector('.historyItemMoreBtn');
                const dropdownMenu = itemDiv.querySelector('.historyDropdownMenu');

                moreBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isAlreadyOpen = dropdownMenu.classList.contains('show');
                    closeAllDropdowns();
                    if (!isAlreadyOpen) {
                        dropdownMenu.classList.add('show');
                        moreBtn.classList.add('menuOpen');
                        itemDiv.classList.add('hasOpenMenu');
                        document.body.classList.add('hasOpenHistoryMenu');
                    }
                });

                // 1. Eylem: Sohbeti Sabitle / Sabitlemeyi Kaldır
                const pinBtn = itemDiv.querySelector('.actionPin');
                pinBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    togglePinSession(sess.id);
                });

                // 2. Eylem: Yeniden Adlandır
                const renameBtn = itemDiv.querySelector('.actionRename');
                renameBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    openRenameModalForSession(sess);
                });

                // 3. Eylem: Sil
                const deleteBtn = itemDiv.querySelector('.actionDelete');
                deleteBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    deleteSessionConfirmed(sess);
                });

                groupDiv.appendChild(itemDiv);
            });

            chatHistorySection.appendChild(groupDiv);
        }

        // Tüm açık dropdown menülerini kapat
        function closeAllDropdowns() {
            document.querySelectorAll('.historyDropdownMenu.show').forEach(menu => {
                menu.classList.remove('show');
            });
            document.querySelectorAll('.historyItemMoreBtn.menuOpen').forEach(btn => {
                btn.classList.remove('menuOpen');
            });
            document.querySelectorAll('.historyItem.hasOpenMenu, .savedWidgetItem.hasOpenMenu').forEach(item => {
                item.classList.remove('hasOpenMenu');
            });
            document.body.classList.remove('hasOpenHistoryMenu');
        }

        // Sayfada başka bir yere tıklandığında açık olan 3 nokta menülerini kapat
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.historyItemMoreBtn') && !e.target.closest('.historyDropdownMenu')) {
                closeAllDropdowns();
            }
        });

        // Sohbeti Sabitleme Mantığı
        async function togglePinSession(sessionId) {
            try {
                const response = await fetch(`/chat/conversations/${sessionId}/pin`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    await fetchAndInitializeHistory();
                }
            } catch (err) {
                console.error("Pin değiştirilemedi:", err);
            }
        }

        // ==========================================
        // YENİDEN ADLANDIRMA MODAL YÖNETİMİ
        // ==========================================
        const renameModalOverlay = document.getElementById('renameModalOverlay');
        const renameModalInput = document.getElementById('renameModalInput');
        const renameCancelBtn = document.getElementById('renameCancelBtn');
        const renameSaveBtn = document.getElementById('renameSaveBtn');
        let sessionToRename = null;

        function openRenameModalForSession(sess) {
            sessionToRename = sess;
            if (renameModalInput) {
                renameModalInput.value = sess.title;
            }
            if (renameModalOverlay) {
                renameModalOverlay.classList.add('active');
                setTimeout(() => {
                    if (renameModalInput) {
                        renameModalInput.focus();
                        renameModalInput.select();
                    }
                }, 50);
            }
        }

        function closeRenameModal() {
            if (renameModalOverlay) {
                renameModalOverlay.classList.remove('active');
            }
            sessionToRename = null;
        }

        async function saveSessionRename() {
            if (!sessionToRename || !renameModalInput) return;
            const newTitle = renameModalInput.value.trim();
            if (!newTitle) return;

            try {
                const response = await fetch(`/chat/conversations/${sessionToRename.id}/rename`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: newTitle })
                });

                if (response.ok) {
                    closeRenameModal();
                    await fetchAndInitializeHistory();
                } else {
                    alert("Sohbet adı güncellenemedi.");
                }
            } catch (err) {
                console.error("Yeniden adlandırma hatası:", err);
                alert("Bağlantı hatası.");
            }
        }

        if (renameCancelBtn) {
            renameCancelBtn.addEventListener('click', closeRenameModal);
        }
        if (renameSaveBtn) {
            renameSaveBtn.addEventListener('click', saveSessionRename);
        }
        if (renameModalOverlay) {
            renameModalOverlay.addEventListener('click', (e) => {
                if (e.target === renameModalOverlay) {
                    closeRenameModal();
                }
            });
        }
        if (renameModalInput) {
            renameModalInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    saveSessionRename();
                }
            });
        }

        // ==========================================
        // SOHBETİ SİLME EYLEMİ
        // ==========================================
        async function deleteSessionConfirmed(session) {
            const isConfirmed = confirm(`"${session.title}" ${I18N.confirmDeleteChat}`);
            if (!isConfirmed) return;

            try {
                const response = await fetch(`/chat/conversations/${session.id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    if (activeConversationId === session.id) {
                        activeConversationId = null;
                        finishActiveTyping();
                        removeLoading();
                        chatArea.innerHTML = '';
                        checkWelcomeState();
                    }

                    await fetchAndInitializeHistory();
                } else {
                    const errData = await response.json().catch(() => ({}));
                    alert(errData.error || "Sohbet silinirken bir hata oluştu.");
                }
            } catch (err) {
                console.error("Sohbet silme hatası:", err);
                alert("Sunucu ile iletişim kurulurken bir hata oluştu.");
            }
        }

        // Tıklanan Konuşmayı Chat Ekranına Yükleme
        async function loadConversationToChat(session, activeElement) {
            finishActiveTyping();
            removeLoading();

            activeConversationId = session.id;

            // .active sınıfını güncelle
            document.querySelectorAll('.historyItem.active').forEach(el => el.classList.remove('active'));
            if (activeElement) {
                activeElement.classList.add('active');
            }

            // Ekranı temizle
            chatArea.innerHTML = '';
            
            if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'none';
            if (chatArea) chatArea.style.display = 'flex';
            if (messageInputContainer) {
                messageInputContainer.classList.remove('heroMode');
                chatContainer.appendChild(messageInputContainer);
            }

            try {
                const response = await fetch(`/chat/conversations/${session.id}/messages`);
                if (!response.ok) throw new Error("Mesajlar alınamadı");
                const data = await response.json();
                const messages = data.messages || [];

                if (activeConversationId !== session.id) return;

                messages.forEach(msg => {
                    const messageDiv = document.createElement('div');
                    if (msg.id) {
                        messageDiv.dataset.messageId = msg.id;
                    }
                    if (msg.role === 'user') {
                        messageDiv.className = 'userMessage';
                        messageDiv.innerHTML = `<div class="userMessageBubble">${escapeHtml(msg.content.trim())}</div>`;
                    } else {
                        messageDiv.className = 'welcomeMessage';
                        messageDiv.innerHTML = `
                            <div class="aiAvatar">
                                <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                            </div>
                            <div class="aiResponseContent">
                                <div class="aiMessageBubble">${escapeHtml(msg.content.trim())}</div>
                            </div>
                        `;
                        if (msg.widget) {
                            const widgetEl = renderWidgetDOM(msg.widget);
                            if (widgetEl) {
                                messageDiv.querySelector('.aiResponseContent').appendChild(widgetEl);
                            }
                        }
                    }
                    chatArea.appendChild(messageDiv);
                });

                chatArea.scrollTop = chatArea.scrollHeight;
            } catch (err) {
                console.error("Mesaj yükleme hatası:", err);
                chatArea.innerHTML = '<div class="historyNotFound">Sohbet mesajları yüklenirken bir hata oluştu.</div>';
            }

            if (window.innerWidth <= 768) {
                closeSidebar();
            }
        }

        // Backend'den Konuşma Listesini Çekip Başlatma
        async function fetchAndInitializeHistory() {
            try {
                const response = await fetch('/chat/conversations');
                if (response.ok) {
                    const data = await response.json();
                    const conversations = data.conversations || [];
                    allChatSessions = conversations.map(c => ({
                        ...c,
                        category: getDateCategory(c.updated_at)
                    }));
                    renderSidebarHistory(searchInput ? searchInput.value : '');
                } else {
                    renderSidebarHistory(searchInput ? searchInput.value : '');
                }
            } catch (err) {
                console.error("Geçmiş sohbetler yüklenemedi:", err);
                renderSidebarHistory(searchInput ? searchInput.value : '');
            }
        }

        // ==========================================
        // SİDEBAR SEKMELERİ & KAYITLI TARİFLERİM (Aşama D)
        // ==========================================
        const tabChatsBtn = document.getElementById('tabChatsBtn');
        const tabRecipesBtn = document.getElementById('tabRecipesBtn');
        const recipesBadge = document.getElementById('recipesBadge');
        const savedWidgetsSection = document.getElementById('savedWidgetsSection');
        let activeSidebarTab = 'chats'; // 'chats' veya 'recipes'
        let allSavedWidgets = [];

        function switchSidebarTab(tabName) {
            activeSidebarTab = tabName;
            if (tabName === 'chats') {
                if (tabChatsBtn) tabChatsBtn.classList.add('active');
                if (tabRecipesBtn) tabRecipesBtn.classList.remove('active');
                if (chatHistorySection) chatHistorySection.style.display = 'block';
                if (savedWidgetsSection) savedWidgetsSection.style.display = 'none';
                if (searchInput) {
                    searchInput.placeholder = I18N.searchPlaceholderChats;
                    renderSidebarHistory(searchInput.value);
                }
            } else if (tabName === 'recipes') {
                if (tabRecipesBtn) tabRecipesBtn.classList.add('active');
                if (tabChatsBtn) tabChatsBtn.classList.remove('active');
                if (chatHistorySection) chatHistorySection.style.display = 'none';
                if (savedWidgetsSection) savedWidgetsSection.style.display = 'flex';
                if (searchInput) {
                    searchInput.placeholder = I18N.searchPlaceholderRecipes;
                    renderSavedWidgets(searchInput.value);
                }
            }
        }

        if (tabChatsBtn) {
            tabChatsBtn.addEventListener('click', () => switchSidebarTab('chats'));
        }
        if (tabRecipesBtn) {
            tabRecipesBtn.addEventListener('click', () => switchSidebarTab('recipes'));
        }

        // Backend'den Kayıtlı Widget'ları (Tarif & Besin) Çekme
        async function fetchAndRenderSavedWidgets() {
            try {
                const response = await fetch('/widgets/saved');
                if (response.ok) {
                    const data = await response.json();
                    const rawWidgets = data.widgets || [];
                    allSavedWidgets = rawWidgets.map(w => ({
                        id: w.id,
                        type: w.widget_type || w.type || 'recipe',
                        title: w.title,
                        data: w.widget_data || w.data || {},
                        conversation_id: w.conversation_id,
                        related_message_id: w.related_message_id,
                        is_pinned: w.is_pinned === 1 || w.is_pinned === true,
                        created_at: w.created_at
                    }));
                    if (recipesBadge) {
                        recipesBadge.textContent = allSavedWidgets.length;
                    }
                    if (activeSidebarTab === 'recipes') {
                        renderSavedWidgets(searchInput ? searchInput.value : '');
                    }
                }
            } catch (err) {
                console.error("Kayıtlı tarifler yüklenemedi:", err);
            }
        }

        // Kayıtlı Widget'ları Sidebar'da Listeleme (Sekmeye özel izole arama filtresiyle)
        function renderSavedWidgets(filterQuery = '') {
            if (!savedWidgetsSection) return;
            savedWidgetsSection.innerHTML = '';

            const q = filterQuery.toLowerCase().trim();
            const filtered = q
                ? allSavedWidgets.filter(w => {
                    const title = (w.title || '').toLowerCase();
                    const type = (w.type || '').toLowerCase();
                    const note = (w.data && (w.data.food_name || w.data.dietitian_note || '')) ? String(w.data.food_name || w.data.dietitian_note).toLowerCase() : '';
                    return title.includes(q) || type.includes(q) || note.includes(q);
                })
                : allSavedWidgets;

            if (allSavedWidgets.length === 0) {
                savedWidgetsSection.innerHTML = `
                    <div class="historyEmptyState">
                        <span class="emptyIcon">🍲</span>
                        ${I18N.emptyRecipes}
                    </div>
                `;
                return;
            }

            if (filtered.length === 0) {
                savedWidgetsSection.innerHTML = `
                    <div class="historyNotFound">
                        "${escapeHtml(filterQuery)}" ${I18N.notFoundRecipes}
                    </div>
                `;
                return;
            }

            filtered.forEach(w => {
                const isPinned = w.is_pinned === 1 || w.is_pinned === true;
                const itemDiv = document.createElement('div');
                itemDiv.className = 'savedWidgetItem' + (isPinned ? ' isPinned' : '');
                itemDiv.dataset.widgetId = w.id;

                const isRecipe = w.type === 'recipe';
                const icon = isRecipe ? '🍲' : '🥗';
                const typeLabel = isRecipe ? I18N.recipe : I18N.nutritionSummary;
                const title = escapeHtml(w.title || (isRecipe ? I18N.recipeDefault : I18N.nutritionSummary));
                
                let metaText = '';
                if (isRecipe && w.data) {
                    const time = (w.data.prep_time_min || 10) + (w.data.cook_time_min || 20);
                    metaText = `⏱️ ${time} dk ${w.data.calories_approx ? `• ~${w.data.calories_approx} kcal` : ''}`;
                } else if (w.data && w.data.total_calories) {
                    metaText = `⚡ ${w.data.total_calories} kcal • ${escapeHtml(w.data.amount_label || I18N.portion)}`;
                }

                const dateStr = w.created_at
                    ? new Date(w.created_at * 1000).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' })
                    : '';

                itemDiv.innerHTML = `
                    <div class="savedWidgetTopRow">
                        <span class="savedWidgetIcon">${icon}</span>
                        <div class="savedWidgetInfo">
                            <div class="savedWidgetTitleRow">
                                ${isPinned ? '<span class="savedWidgetPinIcon" title="' + I18N.pinned + '">📌</span>' : ''}
                                <span class="savedWidgetTitle">${title}</span>
                            </div>
                            <div class="savedWidgetMeta">
                                <span class="savedWidgetMetaTag">${typeLabel}</span>
                                ${metaText ? `<span>${metaText}</span>` : ''}
                            </div>
                        </div>
                        <button type="button" class="historyItemMoreBtn savedWidgetMoreBtn" title="${I18N.options}" aria-label="${I18N.options}">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"></circle>
                                <circle cx="12" cy="12" r="2"></circle>
                                <circle cx="12" cy="19" r="2"></circle>
                            </svg>
                        </button>
                        <div class="historyDropdownMenu savedWidgetDropdownMenu">
                            <button type="button" class="dropdownActionItem actionPinWidget">
                                <span class="dropdownActionIcon">${isPinned ? '📍' : '📌'}</span>
                                <span>${isPinned ? I18N.unpinRecipe : I18N.pinRecipe}</span>
                            </button>
                            <button type="button" class="dropdownActionItem danger actionDeleteWidget">
                                <span class="dropdownActionIcon">🗑️</span>
                                <span>${I18N.deleteRecipe}</span>
                            </button>
                        </div>
                    </div>
                    <div class="savedWidgetBottomRow">
                        <span class="savedWidgetDate">${dateStr}</span>
                        ${(w.conversation_id && w.related_message_id) ? `
                            <button type="button" class="savedWidgetJumpBtn" data-conv-id="${w.conversation_id}" data-msg-id="${w.related_message_id}">
                                <span>${I18N.jumpToChat}</span>
                                <span>↗</span>
                            </button>
                        ` : ''}
                    </div>
                `;

                // Kartın geneline tıklanınca Stage C modalı açılsın
                itemDiv.addEventListener('click', (e) => {
                    if (e.target.closest('.savedWidgetMoreBtn') || e.target.closest('.historyDropdownMenu') || e.target.closest('.savedWidgetJumpBtn')) return;
                    openWidgetDetailModal(w);
                });

                // 3 Nokta Butonu Etkileşimi
                const moreBtn = itemDiv.querySelector('.savedWidgetMoreBtn');
                const dropdownMenu = itemDiv.querySelector('.savedWidgetDropdownMenu');

                moreBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isAlreadyOpen = dropdownMenu.classList.contains('show');
                    closeAllDropdowns();
                    if (!isAlreadyOpen) {
                        dropdownMenu.classList.add('show');
                        moreBtn.classList.add('menuOpen');
                        itemDiv.classList.add('hasOpenMenu');
                    }
                });

                // 1. Eylem: Sabitle / Sabitlemeyi Kaldır
                const pinBtn = itemDiv.querySelector('.actionPinWidget');
                pinBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    togglePinWidget(w.id);
                });

                // 2. Eylem: Sil
                const deleteBtn = itemDiv.querySelector('.actionDeleteWidget');
                deleteBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    deleteWidgetConfirmed(w);
                });

                // "Bu Sohbete Git" butonuna tıklanınca o konuşmaya ve mesaja atla
                const jumpBtn = itemDiv.querySelector('.savedWidgetJumpBtn');
                if (jumpBtn) {
                    jumpBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const convId = parseInt(jumpBtn.dataset.convId, 10);
                        const msgId = parseInt(jumpBtn.dataset.msgId, 10);
                        jumpToConversationMessage(convId, msgId);
                    });
                }

                savedWidgetsSection.appendChild(itemDiv);
            });
        }

        // Kayıtlı Tarifi Sabitleme Mantığı
        async function togglePinWidget(widgetId) {
            try {
                const response = await fetch(`/widgets/saved/${widgetId}/pin`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    await fetchAndRenderSavedWidgets();
                } else {
                    alert("Sabitleme durumu değiştirilemedi.");
                }
            } catch (err) {
                console.error("Tarif sabitleme hatası:", err);
            }
        }

        // Kayıtlı Tarifi Silme Mantığı
        async function deleteWidgetConfirmed(widget) {
            const isConfirmed = confirm(`"${widget.title || I18N.recipeDefault}" ${I18N.confirmDeleteRecipe}`);
            if (!isConfirmed) return;

            try {
                const response = await fetch(`/widgets/saved/${widget.id}`, {
                    method: 'DELETE'
                });
                if (response.ok) {
                    await fetchAndRenderSavedWidgets();
                } else {
                    const errData = await response.json().catch(() => ({}));
                    alert(errData.error || "Tarif silinirken bir hata oluştu.");
                }
            } catch (err) {
                console.error("Tarif silme hatası:", err);
                alert("Sunucu ile iletişim kurulurken bir hata oluştu.");
            }
        }

        // Belirli bir sohbetteki belirli mesaja atlama ve vurgulama
        async function jumpToConversationMessage(conversationId, messageId) {
            // 1. Sohbetler sekmesine geç
            switchSidebarTab('chats');

            // 2. İlgili session objesini ve DOM elemanını bul
            const session = allChatSessions.find(s => s.id === conversationId) || { id: conversationId, title: "Sohbet" };
            const historyItemEl = document.querySelector(`.historyItem[data-session-id="${conversationId}"]`);

            // 3. Konuşmayı yükle
            await loadConversationToChat(session, historyItemEl);

            // 4. İlgili mesaja yumuşakça kaydır ve vurgula
            setTimeout(() => {
                const msgEl = document.querySelector(`[data-message-id="${messageId}"]`);
                if (msgEl) {
                    msgEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    msgEl.classList.remove('highlightMessage');
                    void msgEl.offsetWidth; // Reflow tetikle
                    msgEl.classList.add('highlightMessage');
                    setTimeout(() => {
                        msgEl.classList.remove('highlightMessage');
                    }, 3000);
                }
            }, 180);
        }

        // Arama kutusu - Aktif sekmeye göre İZOLE filtreleme yapar
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value;
                if (activeSidebarTab === 'chats') {
                    renderSidebarHistory(query);
                } else if (activeSidebarTab === 'recipes') {
                    renderSavedWidgets(query);
                }
            });
        }

        // Sayfa açılışında hem sohbet geçmişini hem de kayıtlı tarifleri getir
        fetchAndInitializeHistory();
        fetchAndRenderSavedWidgets();

        // ==========================================
        // MEVCUT MESAJLAŞMA & FONKSİYONEL JS MANTIĞI
        // ==========================================
        let currentLoadingBubble = null;
        let activeTypingInterval = null;
        let activeTypingBubble = null;
        let activeTypingFullText = '';
        const TYPING_SPEED_MS = 25; // 25ms per character / speed config

        function finishActiveTyping() {
            if (activeTypingInterval) {
                clearInterval(activeTypingInterval);
                activeTypingInterval = null;
            }
            if (activeTypingBubble && activeTypingFullText) {
                activeTypingBubble.textContent = activeTypingFullText;
                activeTypingBubble = null;
                activeTypingFullText = '';
            }
        }

        function showLoading() {
            if (currentLoadingBubble) return;

            const messageDiv = document.createElement('div');
            messageDiv.className = 'welcomeMessage';
            messageDiv.id = 'loadingIndicator';
            messageDiv.innerHTML = `
                <div class="aiAvatar">
                    <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                </div>
                <div class="aiMessageBubble aiLoadingBubble">
                    <div class="loadingBubble">
                        <span class="loadingText">${I18N.thinking}</span>
                        <div class="typingDots">
                            <div class="dot"></div>
                            <div class="dot"></div>
                            <div class="dot"></div>
                        </div>
                    </div>
                </div>
            `;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
            currentLoadingBubble = messageDiv;
        }

        function removeLoading() {
            if (currentLoadingBubble) {
                currentLoadingBubble.remove();
                currentLoadingBubble = null;
            }
        }

        function addUserMessage(message) {
            finishActiveTyping();
            
            // İlk mesaj gönderildiğinde karşılama ekranını kaldır ve input'u alt konuma taşı
            if (welcomeCenteredGroup && welcomeCenteredGroup.style.display !== 'none') {
                welcomeCenteredGroup.style.display = 'none';
                chatArea.style.display = 'flex';
                messageInputContainer.classList.remove('heroMode');
                chatContainer.appendChild(messageInputContainer);
            }

            const messageDiv = document.createElement('div');
            messageDiv.className = 'userMessage';
            messageDiv.innerHTML = `<div class="userMessageBubble">${escapeHtml(message.trim())}</div>`;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ==========================================
        // WIDGET RENDER SİSTEMİ (Aşama B)
        // ==========================================
        function renderWidgetDOM(widget) {
            if (!widget || typeof widget !== 'object') return null;

            const container = document.createElement('div');
            container.className = 'widgetContainer';
