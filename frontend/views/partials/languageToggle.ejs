<div class="lang-toggle-wrapper">
  <div class="lang-toggle" role="group" aria-label="Language selector">
    <a href="/set-locale/tr?returnTo=<%= encodeURIComponent(currentPath || '/') %>" 
       class="lang-btn <%= currentLocale === 'tr' ? 'active' : '' %>" 
       title="Türkçe">
       <span>TR</span>
    </a>
    <span class="lang-divider">|</span>
    <a href="/set-locale/en?returnTo=<%= encodeURIComponent(currentPath || '/') %>" 
       class="lang-btn <%= currentLocale === 'en' ? 'active' : '' %>" 
       title="English">
       <span>EN</span>
    </a>
  </div>
</div>

<style>
.lang-toggle-wrapper {
  display: inline-flex;
  align-items: center;
  user-select: none;
}

.lang-toggle {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border: 2px solid #2B2118;
  border-radius: 999px;
  padding: 3px 8px;
  box-shadow: 2px 2px 0px #2B2118;
  font-family: 'Fredoka', 'Quicksand', sans-serif;
  font-weight: 700;
  font-size: 0.82rem;
  transition: all 0.15s ease;
}

.lang-toggle:hover {
  transform: translateY(-1px);
  box-shadow: 3px 3px 0px #2B2118;
}

.lang-btn {
  text-decoration: none;
  color: #7A6F68;
  padding: 3px 7px;
  border-radius: 999px;
  transition: all 0.15s ease;
  line-height: 1;
  display: inline-block;
}

.lang-btn:hover {
  color: #2B2118;
}

.lang-btn.active {
  background: #FFEF5A; /* Banana yellow */
  color: #2B2118;
  border: 1.5px solid #2B2118;
  box-shadow: 1px 1px 0px #2B2118;
}

.lang-divider {
  color: #D1C7BD;
  margin: 0 2px;
  font-size: 0.75rem;
}
</style>
