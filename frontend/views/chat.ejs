<!DOCTYPE html>
<html lang="<%= (typeof currentLocale !== 'undefined' && currentLocale) ? currentLocale : 'tr' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('chat.page_title') %></title>
    
    <link rel="stylesheet" href="chat.css">
    <link rel="stylesheet" href="settings.css">
    <link rel="stylesheet" href="widget.css">
    <!-- Fonts: Nunito & Quicksand (Meelo Style - Full Turkish Support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"/>
</head>
<body>
    <div class="appContainer">
        <!-- Sol Claude Tarzı Sidebar (Beyaz Arkaplan) -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebarHeader">
                <div class="brand">
                    <div class="brandLogo">
                        <img src="/image/arfid_icon.png" alt="<%= t('nav.brand') %> Logo" class="brandIconImg">
                    </div>
                    <span class="brandText"><%= t('nav.brand') %></span>
                </div>
                <div class="sidebarHeaderActions">
                    <button class="sidebarCloseBtn" id="sidebarCloseBtn" title="<%= t('chat.close_sidebar') %>" aria-label="<%= t('chat.close_sidebar') %>">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- 1. Üst Kısım: Yeni Sohbet Butonu (Flat Renk + Glow) -->
            <div class="newChatSection">
                <button class="newChatBtn" id="newChatBtn">
                    <span class="newChatIcon">+</span>
                    <span><%= t('chat.new_chat') %></span>
                </button>
            </div>

            <!-- Sekmeler: Sohbetler / Tariflerim -->
            <div class="sidebarTabs">
                <button type="button" class="sidebarTabBtn active" id="tabChatsBtn">
                    <span>💬</span>
                    <span><%= t('chat.tab_chats') %></span>
                </button>
                <button type="button" class="sidebarTabBtn" id="tabRecipesBtn">
                    <span>🍲</span>
                    <span><%= t('chat.tab_recipes') %></span>
                    <span class="recipesBadge" id="recipesBadge">0</span>
                </button>
            </div>

            <!-- 2. Arama Kutusu (Client-side Arama) -->
            <div class="searchSection">
                <div class="searchInputWrapper">
                    <svg class="searchIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="searchInput" id="searchInput" placeholder="<%= t('chat.search_placeholder_chats') %>" aria-label="<%= t('chat.search_placeholder_chats') %>" />
                </div>
            </div>

            <!-- 3. Geçmiş Sohbetler Listesi Alanı -->
            <div class="chatHistorySection" id="chatHistorySection">
                <!-- Dinamik olarak doldurulur -->
            </div>

            <!-- 3B. Kayıtlı Tarifler Listesi Alanı (Aşama D) -->
            <div class="savedWidgetsSection" id="savedWidgetsSection" style="display: none;">
                <!-- Dinamik olarak doldurulur -->
            </div>

            <!-- 4. Alt Kısım: Profil, Ayarlar ve Logout Alanı -->
            <div class="sidebarFooter">
                <div class="userProfile">
                    <div class="userAvatar">
                        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div class="userInfo">
                        <div class="userName">
                            <%= (typeof user !== 'undefined' && user && user.username) ? user.username : t('chat.user_default') %>
                        </div>
                    </div>
                </div>

                <div class="sidebarActions">
                    <!-- Ayarlar Butonu (⚙️ Settings İkonu) -->
                    <button class="settingsBtn" id="openSettingsBtn" title="<%= t('chat.settings') %>" aria-label="<%= t('chat.settings') %>">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </button>

                    <!-- Çıkış Butonu -->
                    <a href="/logout" class="logoutLink" title="<%= t('chat.logout') %>" aria-label="<%= t('chat.logout') %>">
                        <button class="logoutBtn" type="button">
                            <svg class="logoutIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span class="logoutText"><%= t('chat.logout') %></span>
                        </button>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Claude Tarzı Settings Modal Pop-up -->
        <div class="settingsModalOverlay" id="settingsModalOverlay">
            <div class="settingsModal" id="settingsModal">
                <div class="settingsModalHeader">
                    <div class="settingsModalTitle">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span><%= t('chat.settings') %></span>
                    </div>
                    <button class="settingsCloseBtn" id="closeSettingsBtn" title="<%= t('chat.close') %>" aria-label="<%= t('chat.close') %>">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="settingsModalBody">
                    <!-- Sol Panel (Dar Dikey Menü) -->
                    <div class="settingsSidebar">
                        <button class="settingsTabItem active" id="settingsTabProfile" type="button" data-tab="profile">
                            <svg class="settingsTabIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span><%= t('chat.profile') %></span>
                        </button>
                        <button class="settingsTabItem" id="settingsTabDietary" type="button" data-tab="dietary">
                            <svg class="settingsTabIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                                <path d="M2 17l10 5 10-5"></path>
                                <path d="M2 12l10 5 10-5"></path>
                            </svg>
                            <span><%= t('chat.dietary_profile') %></span>
                        </button>
                    </div>

                    <!-- Sağ Panel (Geniş İçerik Alanı) -->
                    <div class="settingsContent">
                        <!-- 1. Profil Sekmesi İçeriği -->
                        <div class="settingsTabPane active" id="settingsPaneProfile">
                            <h2 class="settingsSectionTitle"><%= t('chat.profile_info') %></h2>
                            <p class="settingsSectionDesc"><%= t('chat.profile_desc') %></p>

                            <div class="settingsAvatarRow">
                                <div class="settingsAvatarLarge">
                                    <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                                </div>
                                <div class="settingsAvatarInfo">
                                    <span class="settingsAvatarLabel"><%= (typeof user !== 'undefined' && user && user.username) ? user.username : t('chat.user_default') %></span>
                                    <span class="settingsAvatarSub"><%= (typeof user !== 'undefined' && user && user.email) ? user.email : t('chat.user_initial_badge') %></span>
                                </div>
                            </div>

                            <div class="settingsFormGroup">
                                <label class="settingsLabel" for="settingsUsername"><%= t('auth.username') %></label>
                                <input type="text" class="settingsInput" id="settingsUsername" value="<%= (typeof user !== 'undefined' && user && user.username) ? user.username : '' %>" placeholder="<%= t('auth.username_placeholder') %>">
                            </div>

                            <div class="settingsFormGroup">
                                <label class="settingsLabel" for="settingsEmail"><%= t('auth.email') %></label>
                                <input type="email" class="settingsInput" id="settingsEmail" value="<%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %>" placeholder="<%= t('auth.email_placeholder') %>">
                            </div>

                            <div class="settingsFormGroup">
                                <label class="settingsLabel"><%= t('chat.language_selection') %></label>
                                <div class="settingsLanguageWrapper">
                                    <%- include('partials/languageToggle') %>
                                </div>
                            </div>

                            <div class="settingsActions">
                                <span class="settingsNoticeText" id="settingsNoticeText"></span>
                                <button type="button" class="settingsSaveBtn" id="settingsSaveBtn"><%= t('chat.save') %></button>
                            </div>

                            <!-- Şifre Değiştirme Bölümü -->
                            <hr class="settingsDivider">
                            <h3 class="settingsSubTitle">
                                <span>🔒</span>
                                <span><%= t('chat.change_password_title') %></span>
                            </h3>

                            <div class="settingsFormGroup">
                                <label class="settingsLabel" for="settingsCurrentPassword"><%= t('chat.current_password') %></label>
                                <input type="password" class="settingsInput" id="settingsCurrentPassword" placeholder="<%= t('chat.current_password_placeholder') %>">
                            </div>

                            <div class="settingsFormGroup">
                                <label class="settingsLabel" for="settingsNewPassword"><%= t('chat.new_password') %></label>
                                <input type="password" class="settingsInput" id="settingsNewPassword" placeholder="<%= t('chat.new_password_placeholder') %>">
                            </div>

                            <div class="settingsFormGroup">
                                <label class="settingsLabel" for="settingsConfirmNewPassword"><%= t('chat.confirm_new_password') %></label>
                                <input type="password" class="settingsInput" id="settingsConfirmNewPassword" placeholder="<%= t('chat.confirm_new_password_placeholder') %>">
                            </div>

                            <div class="settingsActions">
                                <span class="settingsNoticeText" id="settingsPasswordNotice"></span>
                                <button type="button" class="settingsBtnSecondary" id="settingsChangePasswordBtn"><%= t('chat.update_password_btn') %></button>
                            </div>

                            <!-- Hesap Silme Butonu -->
                            <div class="settingsDangerZone">
                                <button type="button" class="settingsDangerBtn" id="deleteAccountBtn"><%= t('chat.delete_account_btn') %></button>
                            </div>
                        </div>

                        <!-- 2. Beslenme Profilim (ARFID Memory) Sekmesi İçeriği -->
                        <div class="settingsTabPane" id="settingsPaneDietary">
                            <h2 class="settingsSectionTitle"><%= t('chat.dietary_profile_title') %></h2>
                            <p class="settingsSectionDesc"><%= t('chat.dietary_profile_desc') %></p>

                            <div id="dietaryLoadingState" class="dietaryLoading" style="display: none;">
                                <div class="typingDots"><div class="dot"></div><div class="dot"></div><div class="dot"></div></div>
                                <span><%= t('chat.loading_dietary') %></span>
                            </div>

                            <div id="dietaryContentContainer">
                                <!-- Güvenli Gıdalar -->
                                <div class="dietaryGroup">
                                    <div class="dietaryGroupHeader">
                                        <span class="dietaryGroupBadge"><span>🥦</span> <span><%= t('chat.safe_foods') %></span></span>
                                        <span class="dietaryCount" id="safeFoodsCount">0</span>
                                    </div>
                                    <div class="dietaryTagsContainer" id="safeFoodsList"></div>
                                </div>

                                <!-- Kaçınılan Gıdalar -->
                                <div class="dietaryGroup">
                                    <div class="dietaryGroupHeader">
                                        <span class="dietaryGroupBadge"><span>🚫</span> <span><%= t('chat.avoided_foods') %></span></span>
                                        <span class="dietaryCount" id="unsafeFoodsCount">0</span>
                                    </div>
                                    <div class="dietaryTagsContainer" id="unsafeFoodsList"></div>
                                </div>

                                <!-- Duyusal Tetikleyiciler -->
                                <div class="dietaryGroup">
                                    <div class="dietaryGroupHeader">
                                        <span class="dietaryGroupBadge"><span>✨</span> <span><%= t('chat.sensory_triggers') %></span></span>
                                        <span class="dietaryCount" id="sensoryTriggersCount">0</span>
                                    </div>
                                    <div class="dietaryTagsContainer" id="sensoryTriggersList"></div>
                                </div>

                                <!-- Düzenle Modu Alt Araç Çubuğu -->
                                <div class="dietaryFooter">
                                    <button type="button" class="dietaryEditBtn" id="dietaryEditBtn">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span id="dietaryEditBtnText"><%= t('chat.edit') %></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Beslenme Profilim Silme Onay Mini-Popup'ı -->
                <div class="dietaryConfirmOverlay" id="dietaryConfirmOverlay">
                    <div class="dietaryConfirmBox">
                        <div class="dietaryConfirmIcon">🗑️</div>
                        <div class="dietaryConfirmTitle"><%= t('chat.delete_confirm_title') %></div>
                        <div class="dietaryConfirmMessage" id="dietaryConfirmMessage"></div>
                        <div class="dietaryConfirmActions">
                            <button type="button" class="dietaryConfirmCancelBtn" id="dietaryConfirmCancelBtn"><%= t('chat.cancel') %></button>
                            <button type="button" class="dietaryConfirmDeleteBtn" id="dietaryConfirmDeleteBtn"><%= t('chat.yes_delete') %></button>
                        </div>
                    </div>
                </div>

                <!-- Hesap Silme Onay Mini-Popup'ı (Danger Zone) -->
                <div class="dietaryConfirmOverlay" id="accountDeleteConfirmOverlay">
                    <div class="dietaryConfirmBox" style="border-color: #FF5A5F;">
                        <div class="dietaryConfirmIcon">⚠️</div>
                        <div class="dietaryConfirmTitle" style="color: #C92A2A;"><%= t('chat.delete_account_confirm_title') %></div>
                        <div class="dietaryConfirmMessage" style="color: #7A3E3E;">
                            <%= t('chat.delete_account_confirm_msg') %>
                        </div>
                        <div class="dietaryConfirmActions">
                            <button type="button" class="dietaryConfirmCancelBtn" id="accountDeleteCancelBtn"><%= t('chat.cancel') %></button>
                            <button type="button" class="dietaryConfirmDeleteBtn" id="accountDeleteConfirmBtn" style="background-color: #C92A2A;"><%= t('chat.yes_delete_account') %></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sohbet Yeniden Adlandırma Modalı -->
        <div class="renameModalOverlay" id="renameModalOverlay">
            <div class="renameModal">
                <div class="renameModalTitle"><%= t('chat.rename_title') %></div>
                <input type="text" class="renameModalInput" id="renameModalInput" placeholder="<%= t('chat.rename_placeholder') %>" maxlength="60">
                <div class="renameModalActions">
                    <button type="button" class="renameCancelBtn" id="renameCancelBtn"><%= t('chat.cancel') %></button>
                    <button type="button" class="renameSaveBtn" id="renameSaveBtn"><%= t('chat.save') %></button>
                </div>
            </div>
        </div>

        <!-- Widget Detay Pop-up Modalı (Aşama C) -->
        <%- include('partials/widgets/widgetDetailModal') %>

        <!-- Sidebar Kapalıyken Gösterilecek Açma Butonu Toggle -->
        <button class="sidebarOpenBtn" id="sidebarOpenBtn" title="<%= t('chat.open_sidebar') %>" aria-label="<%= t('chat.open_sidebar') %>">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="sidebarBackdrop" id="sidebarBackdrop"></div>

        <!-- Ana Chat Alanı -->
        <main class="mainChat">
            <div class="chatContainer">
                
                <!-- 4. DİKEY VE YATAY ORTALANMIŞ KARŞILAMA EKRANI (Başlık + Alt Başlık + Input Tek Grup) -->
                <div class="welcomeCenteredGroup" id="welcomeCenteredGroup">
                    <div class="welcomeMascot">
                        <img src="/image/arfid_icon.png" alt="<%= t('nav.brand') %>" class="mascotIconImg">
                    </div>
                    <h1 class="welcomeHeroTitle"><%= t('chat.welcome_user') %>, <%= (typeof user !== 'undefined' && user && user.username) ? user.username : t('chat.user_default') %></h1>
                    <p class="welcomeHeroSubtitle"><%= t('chat.welcome_subtitle') %></p>
                    
                    <!-- Karşılama Ekranındayken Input Bar Buraya Entegre Olur -->
                    <div class="messageInputContainer heroMode" id="messageInputContainer">
                        <div class="messageInputWrapper">
                            <input type="text" class="messageInput" id="messageInput" placeholder="<%= t('chat.input_placeholder') %>" autocomplete="off">
                            <button class="sendButton" id="sendButton" title="<%= t('chat.send') %>" aria-label="<%= t('chat.send') %>">
                                <svg class="sendIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="19" x2="12" y2="5"></line>
                                    <polyline points="5 12 12 5 19 12"></polyline>
                                </svg>
                            </button>
                        </div>
                        <div class="inputHint"><%= t('chat.input_hint') %></div>
                    </div>
                </div>

                <!-- Chat Mesajları Akış Alanı (Mesajlar başlayınca görünür) -->
                <div class="chatArea" id="chatArea" style="display: none;">
                    <!-- Dinamik mesajlar buraya eklenecektir -->
                </div>
            </div>
        </main>
    </div>

    <script>
        // Sidebar Açma / Kapatma Mantığı (UI Katmanı)
        const sidebar = document.getElementById('sidebar');
        const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
        const sidebarOpenBtn = document.getElementById('sidebarOpenBtn');
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');
        const newChatBtn = document.getElementById('newChatBtn');
        
        const welcomeCenteredGroup = document.getElementById('welcomeCenteredGroup');
        const chatContainer = document.querySelector('.chatContainer');
        const messageInputContainer = document.getElementById('messageInputContainer');
        const chatArea = document.getElementById('chatArea');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');

        function openSidebar() {
            sidebar.classList.remove('collapsed');
            sidebarBackdrop.classList.add('active');
            sidebarOpenBtn.classList.remove('visible');
        }

        function closeSidebar() {
            sidebar.classList.add('collapsed');
            sidebarBackdrop.classList.remove('active');
            sidebarOpenBtn.classList.add('visible');
        }

        if (sidebarCloseBtn) {
            sidebarCloseBtn.addEventListener('click', closeSidebar);
        }
        if (sidebarOpenBtn) {
            sidebarOpenBtn.addEventListener('click', openSidebar);
        }
        if (sidebarBackdrop) {
            sidebarBackdrop.addEventListener('click', closeSidebar);
        }

        // ==========================================
        // AYARLAR (SETTINGS) MODAL ETKİLEŞİMİ
        // ==========================================
        const openSettingsBtn = document.getElementById('openSettingsBtn');
        const closeSettingsBtn = document.getElementById('closeSettingsBtn');
        const settingsModalOverlay = document.getElementById('settingsModalOverlay');
        const settingsModal = document.getElementById('settingsModal');
        const settingsSaveBtn = document.getElementById('settingsSaveBtn');
        const settingsNoticeText = document.getElementById('settingsNoticeText');

        function openSettingsModal() {
            if (settingsModalOverlay) {
                settingsModalOverlay.classList.add('active');
                if (settingsNoticeText) settingsNoticeText.textContent = '';
            }
        }

        function closeSettingsModal() {
            if (settingsModalOverlay) {
                settingsModalOverlay.classList.remove('active');
            }
            if (typeof toggleDietaryEditMode === 'function') {
                toggleDietaryEditMode(false);
            }
            if (typeof closeDietaryConfirmModal === 'function') {
                closeDietaryConfirmModal();
            }
            const accDelOverlay = document.getElementById('accountDeleteConfirmOverlay');
            if (accDelOverlay) {
                accDelOverlay.classList.remove('active');
            }
        }

        if (openSettingsBtn) {
            openSettingsBtn.addEventListener('click', openSettingsModal);
        }
        if (closeSettingsBtn) {
            closeSettingsBtn.addEventListener('click', closeSettingsModal);
        }
        if (settingsModalOverlay) {
            settingsModalOverlay.addEventListener('click', function(e) {
                if (e.target === settingsModalOverlay) {
                    closeSettingsModal();
                }
            });
        }

        // Profil Kaydet Butonu (Gerçek PUT /user/profile İsteği)
        const settingsUsernameInput = document.getElementById('settingsUsername');
        const settingsEmailInput = document.getElementById('settingsEmail');

        if (settingsSaveBtn) {
            settingsSaveBtn.addEventListener('click', async function() {
                const username = settingsUsernameInput ? settingsUsernameInput.value.trim() : '';
                const email = settingsEmailInput ? settingsEmailInput.value.trim() : '';

                if (!username || !email) {
                    if (settingsNoticeText) {
                        settingsNoticeText.textContent = 'Kullanıcı adı ve e-posta boş bırakılamaz.';
                        settingsNoticeText.style.color = '#D32F2F';
                        setTimeout(() => { if (settingsNoticeText) settingsNoticeText.textContent = ''; }, 4000);
                    }
                    return;
                }

                try {
                    settingsSaveBtn.disabled = true;
                    settingsSaveBtn.style.opacity = '0.7';

                    const response = await fetch('/user/profile', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username, email })
                    });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        if (settingsNoticeText) {
                            settingsNoticeText.textContent = '<%= t("chat.profile_updated") %>';
                            settingsNoticeText.style.color = '#1E5128';
                            setTimeout(() => { if (settingsNoticeText) settingsNoticeText.textContent = ''; }, 4000);
                        }

                        // Sayfayı yenilemeden sidebar ve avatar bilgilerini anlık güncelle
                        const sidebarUserName = document.querySelector('.userProfile .userName');
                        const sidebarUserAvatar = document.querySelector('.userProfile .userAvatar');
                        const settingsAvatarLabel = document.querySelector('.settingsAvatarLabel');
                        const settingsAvatarLarge = document.querySelector('.settingsAvatarLarge');

                        if (sidebarUserName) sidebarUserName.textContent = data.user.username;
                        if (sidebarUserAvatar) sidebarUserAvatar.textContent = data.user.username.charAt(0).toUpperCase();
                        if (settingsAvatarLabel) settingsAvatarLabel.textContent = data.user.username;
                        if (settingsAvatarLarge) settingsAvatarLarge.textContent = data.user.username.charAt(0).toUpperCase();
                    } else {
                        if (settingsNoticeText) {
                            settingsNoticeText.textContent = data.error || 'Profil güncellenemedi.';
                            settingsNoticeText.style.color = '#D32F2F';
                            setTimeout(() => { if (settingsNoticeText) settingsNoticeText.textContent = ''; }, 4000);
                        }
                    }
                } catch (err) {
                    console.error('Profil güncelleme hatası:', err);
                    if (settingsNoticeText) {
                        settingsNoticeText.textContent = 'Bağlantı hatası oluştu.';
                        settingsNoticeText.style.color = '#D32F2F';
                        setTimeout(() => { if (settingsNoticeText) settingsNoticeText.textContent = ''; }, 4000);
                    }
                } finally {
                    settingsSaveBtn.disabled = false;
                    settingsSaveBtn.style.opacity = '1';
                }
            });
        }

        // ==========================================
        // ŞİFRE DEĞİŞTİRME ETKİLEŞİMİ
        // ==========================================
        const settingsCurrentPassword = document.getElementById('settingsCurrentPassword');
        const settingsNewPassword = document.getElementById('settingsNewPassword');
        const settingsConfirmNewPassword = document.getElementById('settingsConfirmNewPassword');
        const settingsChangePasswordBtn = document.getElementById('settingsChangePasswordBtn');
        const settingsPasswordNotice = document.getElementById('settingsPasswordNotice');

        if (settingsChangePasswordBtn) {
            settingsChangePasswordBtn.addEventListener('click', async function() {
                const currentPassword = settingsCurrentPassword ? settingsCurrentPassword.value : '';
                const newPassword = settingsNewPassword ? settingsNewPassword.value : '';
                const confirmNewPassword = settingsConfirmNewPassword ? settingsConfirmNewPassword.value : '';

                if (!currentPassword) {
                    showPasswordNotice('<%= t("chat.err_current_password_empty") %>', '#D32F2F');
                    return;
                }
                if (!newPassword || newPassword.length < 6) {
                    showPasswordNotice('<%= t("chat.err_password_short") %>', '#D32F2F');
                    return;
                }
                if (newPassword !== confirmNewPassword) {
                    showPasswordNotice('<%= t("chat.err_passwords_mismatch") %>', '#D32F2F');
                    return;
                }
                if (newPassword === currentPassword) {
                    showPasswordNotice('<%= t("chat.err_password_same") %>', '#D32F2F');
                    return;
                }

                try {
                    settingsChangePasswordBtn.disabled = true;
                    settingsChangePasswordBtn.style.opacity = '0.7';

                    const response = await fetch('/user/password', {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ currentPassword, newPassword })
                    });
                    const data = await response.json();

                    if (response.ok && data.success) {
                        showPasswordNotice('<%= t("chat.password_updated") %>', '#1E5128');
                        if (settingsCurrentPassword) settingsCurrentPassword.value = '';
                        if (settingsNewPassword) settingsNewPassword.value = '';
                        if (settingsConfirmNewPassword) settingsConfirmNewPassword.value = '';
                    } else {
                        showPasswordNotice(data.error || 'Şifre güncellenemedi.', '#D32F2F');
                    }
                } catch (err) {
                    console.error('Şifre güncelleme hatası:', err);
                    showPasswordNotice('Bağlantı hatası oluştu.', '#D32F2F');
                } finally {
                    settingsChangePasswordBtn.disabled = false;
                    settingsChangePasswordBtn.style.opacity = '1';
                }
            });
        }

        function showPasswordNotice(msg, color) {
            if (settingsPasswordNotice) {
                settingsPasswordNotice.textContent = msg;
                settingsPasswordNotice.style.color = color;
                setTimeout(() => {
                    if (settingsPasswordNotice) settingsPasswordNotice.textContent = '';
                }, 4000);
            }
        }

