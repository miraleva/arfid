                        <div>
                            <strong>Bilgilendirme Notu:</strong>
                            <div style="margin-top:2px;">${escapeHtml(data.disclaimer || 'Standart besin tablosu (calculateCalories) ile doğrulanmış ortalama değerlerdir.')}</div>
                        </div>
                    </div>
                `;

                bodyHtml = `
                    ${heroHtml}
                    ${imageHtml}
                    ${macrosHtml}
                    ${breakdownHtml}
                    ${disclaimerHtml}
                `;
            }

            // Gövde içeriğini sıfırdan oluşturup bas (Böylece checkbox'lar sıfırlanır)
            widgetModalBody.innerHTML = bodyHtml;
            widgetModalBody.scrollTop = 0;

            // Modalı görünür yap
            widgetModalOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeWidgetDetailModal() {
            if (widgetModalOverlay) {
                widgetModalOverlay.classList.remove('active');
                document.body.style.overflow = '';
            }
        }

        // Kapatma butonları
        if (closeWidgetModalBtn) {
            closeWidgetModalBtn.addEventListener('click', closeWidgetDetailModal);
        }
        if (closeWidgetModalBottomBtn) {
            closeWidgetModalBottomBtn.addEventListener('click', closeWidgetDetailModal);
        }

        // Karartılmış arka plana (overlay) tıklayınca kapatma
        if (widgetModalOverlay) {
            widgetModalOverlay.addEventListener('click', function(e) {
                if (e.target === widgetModalOverlay) {
                    closeWidgetDetailModal();
                }
            });
        }



        // Evrensel ESC Tuşu Desteği (Widget modalı, Ayarlar modalı ve Yeniden adlandırma modalı)
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (widgetModalOverlay && widgetModalOverlay.classList.contains('active')) {
                    closeWidgetDetailModal();
                } else if (typeof settingsModalOverlay !== 'undefined' && settingsModalOverlay && settingsModalOverlay.classList.contains('active')) {
                    closeSettingsModal();
                } else if (typeof renameModalOverlay !== 'undefined' && renameModalOverlay && renameModalOverlay.classList.contains('active')) {
                    closeRenameModal();
                }
            }
        });

        // Widget Butonlarına Tıklandığında Modalı Aç
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.openWidgetPopupBtn');
            if (btn) {
                e.preventDefault();
                e.stopPropagation();
                const jsonStr = btn.dataset.widgetJson;
                if (jsonStr) {
                    try {
                        const widgetObj = JSON.parse(decodeURIComponent(jsonStr));
                        openWidgetDetailModal(widgetObj);
                    } catch (parseErr) {
                        console.error("[Widget Click] JSON parse hatası:", parseErr);
                    }
                }
            }
        });
    </script>
</body>
</html>