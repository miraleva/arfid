<!DOCTYPE html>
<html lang="<%= currentLocale %>">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="<%= t('meta.main_desc') %>"
    />
    <title><%= t('meta.signup_title') %></title>

    <!-- Fonts: Nunito & Quicksand (Meelo Style - Full Turkish Support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"/>

    <!-- CSS -->
    <link rel="stylesheet" href="signUp.css" />
    <style>
      .page-lang-toggle {
        position: absolute;
        top: 24px;
        right: 28px;
        z-index: 100;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Sağ Üst Köşe Dil Değiştirici -->
      <div class="page-lang-toggle">
        <%- include('partials/languageToggle') %>
      </div>

      <!-- Sol Taraf: Duygulu ve Hareketli Geometrik Şekiller Sahnesi -->
      <div class="imageSection">
        <div class="shapesStage">
          <!-- 1. Gülen Güneş / Çiçek (Tangerine) -->
          <svg class="geoShape shape-sun-happy" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="40" fill="#FFA934" stroke="#2B2118" stroke-width="4.5"/>
            <circle cx="36" cy="44" r="5" fill="#2B2118"/>
            <circle cx="64" cy="44" r="5" fill="#2B2118"/>
            <circle cx="38" cy="42" r="1.8" fill="#FFFFFF"/>
            <circle cx="66" cy="42" r="1.8" fill="#FFFFFF"/>
            <path d="M42 58C46 65 54 65 58 58" stroke="#2B2118" stroke-width="4" stroke-linecap="round"/>
            <circle cx="28" cy="54" r="3.5" fill="#F478B0"/>
            <circle cx="72" cy="54" r="3.5" fill="#F478B0"/>
          </svg>

          <!-- 2. Mutlu Dairecik (Bubblegum Pink) -->
          <svg class="geoShape shape-circle-smile" viewBox="0 0 100 100" fill="none">
            <circle cx="50" cy="50" r="42" fill="#F478B0" stroke="#2B2118" stroke-width="4.5"/>
            <circle cx="35" cy="46" r="5" fill="#2B2118"/>
            <circle cx="65" cy="46" r="5" fill="#2B2118"/>
            <path d="M40 58C44 65 56 65 60 58" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
            <circle cx="27" cy="54" r="3.5" fill="#FFEF5A"/>
            <circle cx="73" cy="54" r="3.5" fill="#FFEF5A"/>
          </svg>

          <!-- 3. Sakin / Huzurlu Dörtgen (Avocado Pastel) -->
          <svg class="geoShape shape-rect-calm" viewBox="0 0 100 100" fill="none">
            <rect x="8" y="14" width="84" height="72" rx="20" fill="#A8D46C" stroke="#2B2118" stroke-width="4.5"/>
            <!-- Huzurlu kapalı gözler -->
            <path d="M30 46C34 50 38 50 42 46" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M58 46C62 50 66 50 70 46" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
            <path d="M46 58C49 61 51 61 54 58" stroke="#2B2118" stroke-width="3" stroke-linecap="round"/>
          </svg>

          <!-- 4. Neşeli Çiçek (Banana Yellow) -->
          <svg class="geoShape shape-flower-joy" viewBox="0 0 100 100" fill="none">
            <path d="M50 8C62 8 72 18 75 30C87 33 94 43 94 55C94 67 85 77 74 80C70 91 60 98 48 98C36 98 26 89 23 78C11 75 4 65 4 53C4 41 12 31 23 28C27 16 38 8 50 8Z" fill="#FFEF5A" stroke="#2B2118" stroke-width="4"/>
            <circle cx="38" cy="48" r="5" fill="#2B2118"/>
            <circle cx="62" cy="48" r="5" fill="#2B2118"/>
            <circle cx="50" cy="62" r="5.5" fill="#2B2118"/>
            <circle cx="28" cy="56" r="3.5" fill="#FFA934"/>
            <circle cx="72" cy="56" r="3.5" fill="#FFA934"/>
          </svg>

          <!-- 5. Göz Kırpan Yıldız (Avocado Pastel) -->
          <svg class="geoShape shape-star-cheer" viewBox="0 0 100 100" fill="none">
            <polygon points="50,6 63,36 96,38 71,60 79,92 50,75 21,92 29,60 4,38 37,36" fill="#A8D46C" stroke="#2B2118" stroke-width="4"/>
            <!-- Sol göz kırpıyor -->
            <path d="M36 46L44 50" stroke="#2B2118" stroke-width="4" stroke-linecap="round"/>
            <circle cx="62" cy="47" r="5" fill="#2B2118"/>
            <circle cx="64" cy="45" r="1.6" fill="#FFFFFF"/>
            <path d="M43 59C47 64 53 64 57 59" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
            <circle cx="32" cy="55" r="3.5" fill="#FFEF5A"/>
            <circle cx="68" cy="55" r="3.5" fill="#FFEF5A"/>
          </svg>

          <!-- 6. Sevimli Cesur Üçgen (Bubblegum) -->
          <svg class="geoShape shape-triangle-fun" viewBox="0 0 100 100" fill="none">
            <path d="M50 12L88 84C90 88 86 92 82 92L18 92C14 92 10 88 12 84L50 12Z" fill="#F478B0" stroke="#2B2118" stroke-width="4.5"/>
            <circle cx="40" cy="58" r="5" fill="#2B2118"/>
            <circle cx="60" cy="58" r="5" fill="#2B2118"/>
            <path d="M44 70C48 75 52 75 56 70" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
          </svg>

          <!-- 7. Merkezdeki Sevimli Altıgen (Banana/Tangerine) -->
          <svg class="geoShape shape-hex-cute" viewBox="0 0 100 100" fill="none">
            <polygon points="50,6 88,27 88,73 50,94 12,73 12,27" fill="#FFA934" stroke="#2B2118" stroke-width="4.5"/>
            <circle cx="37" cy="48" r="5" fill="#2B2118"/>
            <circle cx="63" cy="48" r="5" fill="#2B2118"/>
            <path d="M42 60C46 66 54 66 58 60" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
          </svg>

          <!-- Kıvılcımlar -->
          <svg class="sparkle sp-1" width="24" height="24" viewBox="0 0 24 24" fill="#FFEF5A">
            <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
          </svg>
          <svg class="sparkle sp-2" width="22" height="22" viewBox="0 0 24 24" fill="#F478B0">
            <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
          </svg>
          <svg class="sparkle sp-3" width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF">
            <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
          </svg>
          <svg class="sparkle sp-4" width="26" height="26" viewBox="0 0 24 24" fill="#A8D46C">
            <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
          </svg>
        </div>
      </div>

      <!-- Sağ Taraf: Kayıt Formu (Sağa Dayalı) -->
      <div class="leftist">
        <div class="formWidget">
          <form id="signUpForm">
          <div class="title"><%= t('auth.create_account') %></div>
          <div class="subtitle"><%= t('auth.signup_subtitle') %></div>

          <label for="email"><%= t('auth.email') %></label>
          <div class="inputWrapper">
            <input type="text" id="email" name="email" placeholder="<%= t('auth.email_placeholder') %>" required />
          </div>
          <div id="emailWarning" class="warning"></div>
          
          <label for="username"><%= t('auth.username') %></label>
          <div class="inputWrapper">
            <input type="text" id="username" name="username" placeholder="<%= t('auth.username_placeholder') %>" required />
          </div>
          <div id="usernameWarning" class="warning"></div>

          <label for="password"><%= t('auth.password') %></label>
          <div class="inputWrapper">
            <input type="password" id="password" name="password" placeholder="<%= t('auth.password_placeholder') %>" required />
            <button type="button" class="togglePasswordBtn" id="togglePassword" aria-label="Toggle password visibility">
              <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <div id="passwordWarning" class="warning"></div>

          <label for="passwordAgain"><%= t('auth.password_again') %></label>
          <div class="inputWrapper">
            <input type="password" id="passwordAgain" name="passwordAgain" placeholder="<%= t('auth.password_again_placeholder') %>" required />
            <button type="button" class="togglePasswordBtn" id="togglePasswordAgain" aria-label="Toggle password again visibility">
              <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                <line x1="1" y1="1" x2="23" y2="23"></line>
              </svg>
            </button>
          </div>
          <div id="passwordAgainWarning" class="warning"></div>

          <button type="submit" class="signButton"><%= t('auth.btn_signup') %></button>

          <p class="already"><%= t('auth.already_account') %> 
            <a class="signLink" href="/signin"><%= t('auth.btn_signin') %></a>
          </p>
        </form>
      </div>
    </div>
  </div>

    <!-- JS: modül biçiminde modern yükleme -->
    <script type="module" src="/js/app.js"></script>

    <script>
        // Internationalized Client-side Validation Messages
        const i18nMessages = {
            emailInvalid: "<%= t('auth.val_email_invalid') %>",
            usernameShort: "<%= t('auth.val_username_short') %>",
            usernameLong: "<%= t('auth.val_username_long') %>",
            passwordShort: "<%= t('auth.val_password_short') %>",
            passwordLong: "<%= t('auth.val_password_long') %>",
            passwordConfirmEmpty: "<%= t('auth.val_password_confirm_empty') %>",
            passwordsMismatch: "<%= t('auth.val_passwords_mismatch') %>",
            genericSignupError: "<%= t('auth.err_generic_signup') %>",
            networkError: "<%= t('auth.err_network') %>"
        };

        document.getElementById('signUpForm').addEventListener('submit', async function(e) {
            e.preventDefault(); // Prevent default form submission
            
            const email = document.getElementById('email').value;
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const passwordAgain = document.getElementById('passwordAgain').value;
            
            const emailWarning = document.getElementById('emailWarning');
            const usernameWarning = document.getElementById('usernameWarning');
            const passwordWarning = document.getElementById('passwordWarning');
            const passwordAgainWarning = document.getElementById('passwordAgainWarning');
            
            let isValid = true;
            
            // Clear previous warnings
            emailWarning.textContent = '';
            usernameWarning.textContent = '';
            passwordWarning.textContent = '';
            passwordAgainWarning.textContent = '';
            
            // Email validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email || !emailRegex.test(email)) {
                emailWarning.textContent = i18nMessages.emailInvalid;
                isValid = false;
            }
            
            // Username validation
            if (!username || username.length < 3) {
                usernameWarning.textContent = i18nMessages.usernameShort;
                isValid = false;
            } else if (username.length > 20) {
                usernameWarning.textContent = i18nMessages.usernameLong;
                isValid = false;
            }
            
            // Password validation
            if (!password || password.length < 6) {
                passwordWarning.textContent = i18nMessages.passwordShort;
                isValid = false;
            } else if (password.length > 50) {
                passwordWarning.textContent = i18nMessages.passwordLong;
                isValid = false;
            }
            
            // Password confirmation validation
            if (!passwordAgain) {
                passwordAgainWarning.textContent = i18nMessages.passwordConfirmEmpty;
                isValid = false;
            } else if (password !== passwordAgain) {
                passwordAgainWarning.textContent = i18nMessages.passwordsMismatch;
                isValid = false;
            }
            
            if (!isValid) {
                return;
            }
            
            // If validation passes, send data to backend using fetch
            try {
                const response = await fetch('/signup', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        email: email,
                        password: password,
                        username: username
                    })
                });

                if (response.ok) {
                    window.location.href = '/chat';
                } else {
                    const errorData = await response.text();
                    let errorMessage = i18nMessages.genericSignupError;
                    
                    try {
                        const errorJson = JSON.parse(errorData);
                        errorMessage = errorJson.error || errorMessage;
                    } catch (e) {
                        errorMessage = errorData || errorMessage;
                    }
                    
                    emailWarning.textContent = errorMessage;
                }
            } catch (error) {
                console.error('Fetch error:', error);
                emailWarning.textContent = i18nMessages.networkError;
            }
        });
        
        // Clear warnings when user starts typing
        document.getElementById('email').addEventListener('input', function() {
            document.getElementById('emailWarning').textContent = '';
        });
        
        document.getElementById('username').addEventListener('input', function() {
            document.getElementById('usernameWarning').textContent = '';
        });
        
        document.getElementById('password').addEventListener('input', function() {
            document.getElementById('passwordWarning').textContent = '';
            document.getElementById('passwordAgainWarning').textContent = '';
        });
        
        document.getElementById('passwordAgain').addEventListener('input', function() {
            document.getElementById('passwordAgainWarning').textContent = '';
        });

        // Toggle password visibility helper
        function setupTogglePassword(btnId, inputId) {
            const btn = document.getElementById(btnId);
            const input = document.getElementById(inputId);
            if (btn && input) {
                btn.addEventListener('click', function() {
                    const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                    input.setAttribute('type', type);
                    
                    if (type === 'text') {
                        btn.innerHTML = `
                          <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8z"></path>
                            <circle cx="12" cy="12" r="3"></circle>
                          </svg>
                        `;
                    } else {
                        btn.innerHTML = `
                          <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                            <line x1="1" y1="1" x2="23" y2="23"></line>
                          </svg>
                        `;
                    }
                });
            }
        }

        setupTogglePassword('togglePassword', 'password');
        setupTogglePassword('togglePasswordAgain', 'passwordAgain');
    </script>
  </body>
</html>
