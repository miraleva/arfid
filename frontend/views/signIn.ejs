<!DOCTYPE html>
<html lang="<%= currentLocale %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= t('meta.signin_title') %></title>
    <!-- Fonts: Nunito & Quicksand (Meelo Style - Full Turkish Support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700&display=swap"/>
    <link rel="stylesheet" href="signIn.css" />
    <style>
      .page-lang-toggle {
        position: absolute;
        top: 24px;
        right: 28px;
        z-index: 100;
      }
    </style>
</head>
   
    <body>
        <div class="container">
            <!-- Sağ Üst Köşe Dil Değiştirici -->
            <div class="page-lang-toggle">
              <%- include('partials/languageToggle') %>
            </div>

            <!-- Sol Taraf: Duygulu ve Hareketli Geometrik Şekiller Sahnesi -->
            <div class="imageSection">
              <div class="shapesStage">
                <!-- 1. Mutlu Kare (Bubblegum) -->
                <svg class="geoShape shape-square-happy" viewBox="0 0 100 100" fill="none">
                  <rect x="8" y="8" width="84" height="84" rx="22" fill="#F478B0" stroke="#2B2118" stroke-width="4.5"/>
                  <circle cx="34" cy="44" r="5.5" fill="#2B2118"/>
                  <circle cx="66" cy="44" r="5.5" fill="#2B2118"/>
                  <circle cx="36" cy="42" r="1.8" fill="#FFFFFF"/>
                  <circle cx="68" cy="42" r="1.8" fill="#FFFFFF"/>
                  <path d="M42 58C46 65 54 65 58 58" stroke="#2B2118" stroke-width="4" stroke-linecap="round"/>
                  <circle cx="27" cy="53" r="3.5" fill="#FFA934"/>
                  <circle cx="73" cy="53" r="3.5" fill="#FFA934"/>
                </svg>

                <!-- 2. Zeki Gülen Altıgen (Ocean Blue) -->
                <svg class="geoShape shape-hex-smile" viewBox="0 0 100 100" fill="none">
                  <polygon points="50,6 88,27 88,73 50,94 12,73 12,27" fill="#00A0B5" stroke="#2B2118" stroke-width="4.5"/>
                  <circle cx="37" cy="48" r="5" fill="#2B2118"/>
                  <circle cx="63" cy="48" r="5" fill="#2B2118"/>
                  <path d="M42 60C45 66 55 66 58 60" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
                  <circle cx="30" cy="56" r="3" fill="#FFEF5A"/>
                  <circle cx="70" cy="56" r="3" fill="#FFEF5A"/>
                </svg>

                <!-- 3. Sakin / Uykucu Daire (Banana) -->
                <svg class="geoShape shape-circle-sleepy" viewBox="0 0 100 100" fill="none">
                  <circle cx="50" cy="50" r="42" fill="#FFEF5A" stroke="#2B2118" stroke-width="4.5"/>
                  <path d="M30 46C34 50 38 50 42 46" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
                  <path d="M58 46C62 50 66 50 70 46" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
                  <path d="M45 58C48 61 52 61 55 58" stroke="#2B2118" stroke-width="3" stroke-linecap="round"/>
                  <circle cx="28" cy="53" r="3.5" fill="#F478B0"/>
                  <circle cx="72" cy="53" r="3.5" fill="#F478B0"/>
                </svg>

                <!-- 4. Heyecanlı Çiçek / Blob (Tangerine) -->
                <svg class="geoShape shape-blob-excited" viewBox="0 0 100 100" fill="none">
                  <path d="M50 10C68 10 90 28 90 50C90 72 68 90 50 90C32 90 10 72 10 50C10 28 32 10 50 10Z" fill="#FFA934" stroke="#2B2118" stroke-width="4.5"/>
                  <circle cx="36" cy="45" r="5.5" fill="#2B2118"/>
                  <circle cx="64" cy="45" r="5.5" fill="#2B2118"/>
                  <!-- Şaşkın ağız -->
                  <circle cx="50" cy="62" r="6" fill="#2B2118"/>
                  <circle cx="26" cy="52" r="3.5" fill="#FFEF5A"/>
                  <circle cx="74" cy="52" r="3.5" fill="#FFEF5A"/>
                </svg>

                <!-- 5. Göz Kırpan Yıldız (Banana/Yellow) -->
                <svg class="geoShape shape-star-wink" viewBox="0 0 100 100" fill="none">
                  <polygon points="50,6 63,36 96,38 71,60 79,92 50,75 21,92 29,60 4,38 37,36" fill="#FFEF5A" stroke="#2B2118" stroke-width="4"/>
                  <!-- Sol göz kırpıyor -->
                  <path d="M36 46L44 50" stroke="#2B2118" stroke-width="4" stroke-linecap="round"/>
                  <!-- Sağ göz açık -->
                  <circle cx="62" cy="47" r="5" fill="#2B2118"/>
                  <circle cx="64" cy="45" r="1.6" fill="#FFFFFF"/>
                  <path d="M43 59C47 64 53 64 57 59" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
                  <circle cx="32" cy="55" r="3.5" fill="#F478B0"/>
                  <circle cx="68" cy="55" r="3.5" fill="#F478B0"/>
                </svg>

                <!-- 6. Sevimli Cesur Üçgen (Bubblegum/Coral) -->
                <svg class="geoShape shape-triangle-cool" viewBox="0 0 100 100" fill="none">
                  <path d="M50 12L88 84C90 88 86 92 82 92L18 92C14 92 10 88 12 84L50 12Z" fill="#F478B0" stroke="#2B2118" stroke-width="4.5"/>
                  <circle cx="40" cy="58" r="5" fill="#2B2118"/>
                  <circle cx="60" cy="58" r="5" fill="#2B2118"/>
                  <path d="M45 70C48 74 52 74 55 70" stroke="#2B2118" stroke-width="3.5" stroke-linecap="round"/>
                </svg>

                <!-- 7. Merkezdeki Sevimli Beşgen (Purple) -->
                <svg class="geoShape shape-penta-joy" viewBox="0 0 100 100" fill="none">
                  <polygon points="50,10 90,40 75,88 25,88 10,40" fill="#6C5CE7" stroke="#2B2118" stroke-width="4.5"/>
                  <circle cx="39" cy="50" r="5" fill="#FFFFFF"/>
                  <circle cx="61" cy="50" r="5" fill="#FFFFFF"/>
                  <circle cx="41" cy="50" r="2.5" fill="#2B2118"/>
                  <circle cx="63" cy="50" r="2.5" fill="#2B2118"/>
                  <path d="M44 64C47 69 53 69 56 64" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round"/>
                </svg>

                <!-- Eğlenceli Kıvılcım & Parıltılar -->
                <svg class="sparkle sp-1" width="24" height="24" viewBox="0 0 24 24" fill="#FFEF5A">
                  <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
                </svg>
                <svg class="sparkle sp-2" width="22" height="22" viewBox="0 0 24 24" fill="#FFA934">
                  <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
                </svg>
                <svg class="sparkle sp-3" width="20" height="20" viewBox="0 0 24 24" fill="#FFFFFF">
                  <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
                </svg>
                <svg class="sparkle sp-4" width="26" height="26" viewBox="0 0 24 24" fill="#F478B0">
                  <path d="M12 0L14 10L24 12L14 14L12 24L10 14L0 12L10 10Z"/>
                </svg>
              </div>
            </div>

            <!-- Sağ Taraf: Giriş Formu -->
            <div class="login">
              <div class="formWidget">
                <form id="loginForm">
                <div class="title"><%= t('auth.welcome_back') %></div>
                <div class="subtitle"><%= t('auth.signin_subtitle') %></div>
                
                <label for="email"><%= t('auth.email') %></label>
                <div class="inputWrapper">
                  <input type="text" id="email" name="email" placeholder="<%= t('auth.email_placeholder') %>" required />
                </div>
                <div id="emailWarning" class="warning"><%= (typeof error !== 'undefined' && error) ? error : '' %></div>

                <label for="password"><%= t('auth.password') %></label>
                <div class="inputWrapper">
                  <input type="password" id="password" name="password" placeholder="<%= t('auth.password_placeholder') %>" required />
                  <button type="button" class="togglePasswordBtn" id="togglePassword" aria-label="Toggle password visibility">
                    <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                      <line x1="1" y1="1" x2="23" y2="23"></line>
                    </svg>
                  </button>
                </div>
                <div id="passwordWarning" class="warning"></div>

                <div class="checkbox">
                  <label for="remember">
                    <input type="checkbox" id="remember" name="remember">
                    <span><%= t('auth.remember_me') %></span>
                  </label>
                  <a href="/forgot" class="forgot"><%= t('auth.forgot_password') %></a>
                </div>

                <button type="submit" class="signButton"><%= t('auth.btn_signin') %></button>
                
                <p class="noAccount"><%= t('auth.no_account') %> 
                  <a class="signLink" href="/signup"><%= t('auth.btn_signup') %></a>
                </p>
              </form> 
            </div>
          </div>   
        </div>  
    
    <script>
        // Internationalized Client-side Validation Messages
        const i18nMessages = {
            emailInvalid: "<%= t('auth.val_email_invalid') %>",
            passwordShort: "<%= t('auth.val_password_short') %>",
            authFailed: "<%= t('auth.err_auth_failed') %>",
            networkError: "<%= t('auth.err_network') %>"
        };

        document.getElementById('loginForm').addEventListener('submit', async function(e) {
            e.preventDefault(); // Prevent default form submission
            
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const emailWarning = document.getElementById('emailWarning');
            const passwordWarning = document.getElementById('passwordWarning');
            
            let isValid = true;
            
            emailWarning.textContent = '';
            passwordWarning.textContent = '';

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!email || !emailRegex.test(email)) {
                emailWarning.textContent = i18nMessages.emailInvalid;
                isValid = false;
            }
            
            if (!password || password.length < 6) {
                passwordWarning.textContent = i18nMessages.passwordShort;
                isValid = false;
            }
          
            if (!isValid) {
                return;
            }
            
            // If validation passes, send data to backend using fetch
            try {
                const response = await fetch('/signin', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({
                        email: email,
                        password: password
                    })
                });
                
                const data = await response.json().catch(() => null);

                if (response.ok && data && data.success) {
                    window.location.href = data.redirect || '/chat';
                } else {
                    const errorMessage = (data && data.error) ? data.error : i18nMessages.authFailed;
                    emailWarning.textContent = errorMessage;
                }
            } catch (error) {
                console.error('Fetch error:', error);
                emailWarning.textContent = i18nMessages.networkError;
            }
        });
        
        document.getElementById('email').addEventListener('input', function() {
            document.getElementById('emailWarning').textContent = '';
        });
        
        document.getElementById('password').addEventListener('input', function() {
            document.getElementById('passwordWarning').textContent = '';
        });

        // Toggle password visibility
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('password');
        if (togglePassword && passwordInput) {
            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                
                // Toggle eye icon
                if (type === 'text') {
                    togglePassword.innerHTML = `
                      <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                        <circle cx="12" cy="12" r="3"></circle>
                      </svg>
                    `;
                } else {
                    togglePassword.innerHTML = `
                      <svg class="eyeIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                        <line x1="1" y1="1" x2="23" y2="23"></line>
                      </svg>
                    `;
                }
            });
        }
    </script>
    </body>
</html>
