        function addAiMessage(message, widget = null) {
            removeLoading();
            finishActiveTyping();

            const cleanMessage = (message || '').trim();

            const messageDiv = document.createElement('div');
            messageDiv.className = 'welcomeMessage';

            const responseContent = document.createElement('div');
            responseContent.className = 'aiResponseContent';

            const bubbleDiv = document.createElement('div');
            bubbleDiv.className = 'aiMessageBubble typingReveal';
            
            messageDiv.innerHTML = `
                <div class="aiAvatar">
                    <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                </div>
            `;
            responseContent.appendChild(bubbleDiv);

            // Eğer yanıtla birlikte gelen bir widget varsa mesaj içeriğinin (balonun) altına iliştir
            if (widget) {
                const widgetEl = renderWidgetDOM(widget);
                if (widgetEl) {
                    responseContent.appendChild(widgetEl);
                }
            }

            messageDiv.appendChild(responseContent);
            chatArea.appendChild(messageDiv);

            activeTypingBubble = bubbleDiv;
            activeTypingFullText = cleanMessage;

            // Metni kelimelere böl: İlk 3-4 kelimeyi daktilo efektiyle yaz, ardından kalanı akıcı şekilde tamamla
            const words = cleanMessage.split(/\s+/);
            
            // Eğer mesaj çok kısaysa (<= 4 kelime) normal karakter karakter yazdır
            if (words.length <= 4) {
                let charIndex = 0;
                activeTypingInterval = setInterval(() => {
                    charIndex++;
                    bubbleDiv.textContent = cleanMessage.substring(0, charIndex);
                    chatArea.scrollTop = chatArea.scrollHeight;

                    if (charIndex >= cleanMessage.length) {
                        clearInterval(activeTypingInterval);
                        activeTypingInterval = null;
                        activeTypingBubble = null;
                        activeTypingFullText = '';
                    }
                }, TYPING_SPEED_MS);
                return;
            }

            // İlk 3 kelimenin bittiği karakter indeksini bul
            const firstWords = words.slice(0, 3).join(' ') + ' ';
            const targetCharCount = firstWords.length;
            let charIndex = 0;

            // 1. Aşama: İlk 3-4 kelimeyi hızlı ve canlı daktilo efektiyle yaz
            activeTypingInterval = setInterval(() => {
                charIndex += 2; // Akıcı ve seri başlangıç
                if (charIndex >= targetCharCount) {
                    clearInterval(activeTypingInterval);
                    activeTypingInterval = null;
                    
                    // 2. Aşama: İlk 3-4 kelimeden hemen sonra tüm cevabı şık ve profesyonel bir fade/slide geçişiyle göster
                    bubbleDiv.textContent = cleanMessage;
                    bubbleDiv.classList.add('fadeContent');
                    chatArea.scrollTop = chatArea.scrollHeight;

                    activeTypingBubble = null;
                    activeTypingFullText = '';
                } else {
                    bubbleDiv.textContent = cleanMessage.substring(0, charIndex);
                    chatArea.scrollTop = chatArea.scrollHeight;
                }
            }, TYPING_SPEED_MS);
        }

        async function sendMessage() {
            const message = messageInput.value.trim();
            if (message) {
                // Disable UI to prevent spam
                sendButton.disabled = true;
                messageInput.disabled = true;

                addUserMessage(message);
                messageInput.value = '';
                showLoading();

                try {
                    const response = await fetch('/chat', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ 
                            message,
                            conversationId: activeConversationId
                        })
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        if (data.conversation_id) {
                            activeConversationId = data.conversation_id;
                        }
                        addAiMessage(data.response, data.widget);
                        // Yeni mesaj atıldığında geçmiş sohbetler listesini anlık tazele
                        await fetchAndInitializeHistory();
                        // Yeni üretilen bir widget varsa kayıtlı tarifler listesini ve sayacını da tazele
                        await fetchAndRenderSavedWidgets();
                    } else {
                        const data = await response.json().catch(() => ({}));
                        addAiMessage(data.error || "Üzgünüm, şu an cevap veremiyorum. (Sunucu hatası)");
                    }
                } catch (error) {
                    console.error('Chat error:', error);
                    addAiMessage("Bağlantı hatası oluştu. Lütfen sunucuyu kontrol edin.");
                } finally {
                    // Re-enable UI regardless of success or error
                    sendButton.disabled = false;
                    messageInput.disabled = false;
                    messageInput.focus();
                }
            }
        }

        sendButton.addEventListener('click', sendMessage);
        messageInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

