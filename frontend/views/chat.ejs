<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARFID Asistanı - Sohbet</title>
    
    <link rel="stylesheet" href="chat.css">
    <link rel="stylesheet" href="settings.css">
    <link rel="stylesheet" href="widget.css">
    <!-- Fonts: Nunito & Quicksand (Meelo Style - Full Turkish Support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Quicksand:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"/>
</head>
<body>
    <div class="appContainer">
        <!-- Sol Claude Tarzı Sidebar (Beyaz Arkaplan) -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebarHeader">
                <div class="brand">
                    <div class="brandLogo">
                        <img src="/image/arfid_icon.png" alt="Asistancım Logo" class="brandIconImg">
                    </div>
                    <span class="brandText">Asistancım</span>
                </div>
                <button class="sidebarCloseBtn" id="sidebarCloseBtn" title="Sidebar'ı Kapat" aria-label="Sidebar'ı Kapat">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
            </div>

            <!-- 1. Üst Kısım: Yeni Sohbet Butonu (Flat Renk + Glow) -->
            <div class="newChatSection">
                <button class="newChatBtn" id="newChatBtn">
                    <span class="newChatIcon">+</span>
                    <span>Yeni Sohbet</span>
                </button>
            </div>

            <!-- Sekmeler: Sohbetler / Tariflerim -->
            <div class="sidebarTabs">
                <button type="button" class="sidebarTabBtn active" id="tabChatsBtn">
                    <span>💬</span>
                    <span>Sohbetler</span>
                </button>
                <button type="button" class="sidebarTabBtn" id="tabRecipesBtn">
                    <span>🍲</span>
                    <span>Tariflerim</span>
                    <span class="recipesBadge" id="recipesBadge">0</span>
                </button>
            </div>

            <!-- 2. Arama Kutusu (Client-side Arama) -->
            <div class="searchSection">
                <div class="searchInputWrapper">
                    <svg class="searchIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="searchInput" id="searchInput" placeholder="Sohbetlerde ara..." aria-label="Arama yap" />
                </div>
            </div>

            <!-- 3. Geçmiş Sohbetler Listesi Alanı -->
            <div class="chatHistorySection" id="chatHistorySection">
                <!-- Dinamik olarak doldurulur -->
            </div>

            <!-- 3B. Kayıtlı Tarifler Listesi Alanı (Aşama D) -->
            <div class="savedWidgetsSection" id="savedWidgetsSection" style="display: none;">
                <!-- Dinamik olarak doldurulur -->
            </div>

            <!-- 4. Alt Kısım: Profil, Ayarlar ve Logout Alanı -->
            <div class="sidebarFooter">
                <div class="userProfile">
                    <div class="userAvatar">
                        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div class="userInfo">
                        <div class="userName">
                            <%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Kullanıcı' %>
                        </div>
                    </div>
                </div>

                <div class="sidebarActions">
                    <!-- Ayarlar Butonu (⚙️ Settings İkonu) -->
                    <button class="settingsBtn" id="openSettingsBtn" title="Ayarlar" aria-label="Ayarlar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </button>

                    <!-- Çıkış Butonu -->
                    <a href="/logout" class="logoutLink" title="Çıkış Yap" aria-label="Çıkış Yap">
                        <button class="logoutBtn" type="button">
                            <svg class="logoutIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span class="logoutText">Çıkış</span>
                        </button>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Claude Tarzı Settings Modal Pop-up -->
        <div class="settingsModalOverlay" id="settingsModalOverlay">
            <div class="settingsModal" id="settingsModal">
                <div class="settingsModalHeader">
                    <div class="settingsModalTitle">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span>Ayarlar</span>
                    </div>
                    <button class="settingsCloseBtn" id="closeSettingsBtn" title="Kapat" aria-label="Kapat">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="settingsModalBody">
                    <!-- Sol Panel (Dar Dikey Menü) -->
                    <div class="settingsSidebar">
                        <button class="settingsTabItem active" type="button">
                            <svg class="settingsTabIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Profil</span>
                        </button>
                    </div>

                    <!-- Sağ Panel (Geniş İçerik Alanı) -->
                    <div class="settingsContent">
                        <h2 class="settingsSectionTitle">Profil Bilgileri</h2>
                        <p class="settingsSectionDesc">Hesap bilgilerinizi ve asistan tercihlerinizi buradan görüntüleyebilirsiniz.</p>

                        <div class="settingsAvatarRow">
                            <div class="settingsAvatarLarge">
                                <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div class="settingsAvatarInfo">
                                <span class="settingsAvatarLabel"><%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Kullanıcı' %></span>
                                <span class="settingsAvatarSub">Profil Avatarı</span>
                            </div>
                        </div>

                        <div class="settingsFormGroup">
                            <label class="settingsLabel" for="settingsUsername">Kullanıcı Adı</label>
                            <input type="text" class="settingsInput" id="settingsUsername" value="<%= (typeof user !== 'undefined' && user && user.username) ? user.username : '' %>" placeholder="Kullanıcı adınızı girin">
                        </div>

                        <div class="settingsFormGroup">
                            <label class="settingsLabel" for="settingsEmail">E-posta Adresi</label>
                            <input type="email" class="settingsInput" id="settingsEmail" value="<%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %>" placeholder="E-posta adresiniz">
                        </div>

                        <div class="settingsActions">
                            <span class="settingsNoticeText" id="settingsNoticeText"></span>
                            <button type="button" class="settingsSaveBtn" id="settingsSaveBtn">Kaydet</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sohbet Yeniden Adlandırma Modalı -->
        <div class="renameModalOverlay" id="renameModalOverlay">
            <div class="renameModal">
                <div class="renameModalTitle">Sohbeti Yeniden Adlandır</div>
                <input type="text" class="renameModalInput" id="renameModalInput" placeholder="Yeni sohbet başlığı..." maxlength="60">
                <div class="renameModalActions">
                    <button type="button" class="renameCancelBtn" id="renameCancelBtn">İptal</button>
                    <button type="button" class="renameSaveBtn" id="renameSaveBtn">Kaydet</button>
                </div>
            </div>
        </div>

        <!-- Widget Detay Pop-up Modalı (Aşama C) -->
        <%- include('partials/widgets/widgetDetailModal') %>

        <!-- Sidebar Kapalıyken Gösterilecek Açma Butonu Toggle -->
        <button class="sidebarOpenBtn" id="sidebarOpenBtn" title="Sidebar'ı Aç" aria-label="Sidebar'ı Aç">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="sidebarBackdrop" id="sidebarBackdrop"></div>

        <!-- Ana Chat Alanı -->
        <main class="mainChat">
            <div class="chatContainer">
                
                <!-- 4. DİKEY VE YATAY ORTALANMIŞ KARŞILAMA EKRANI (Başlık + Alt Başlık + Input Tek Grup) -->
                <div class="welcomeCenteredGroup" id="welcomeCenteredGroup">
                    <div class="welcomeMascot">
                        <img src="/image/arfid_icon.png" alt="ARFID Asistanı" class="mascotIconImg">
                    </div>
                    <h1 class="welcomeHeroTitle">Hoşgeldiniz, <%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Kullanıcı' %></h1>
                    <p class="welcomeHeroSubtitle">Bugün beslenme yolculuğunda sana nasıl yardımcı olabilirim?</p>
                    
                    <!-- Karşılama Ekranındayken Input Bar Buraya Entegre Olur -->
                    <div class="messageInputContainer heroMode" id="messageInputContainer">
                        <div class="messageInputWrapper">
                            <input type="text" class="messageInput" id="messageInput" placeholder="Duygularınızı, tercihlerinizi veya sorularınızı yazın..." autocomplete="off">
                            <button class="sendButton" id="sendButton" title="Gönder" aria-label="Gönder">
                                <svg class="sendIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="19" x2="12" y2="5"></line>
                                    <polyline points="5 12 12 5 19 12"></polyline>
                                </svg>
                            </button>
                        </div>
                        <div class="inputHint">Asistanımız medikal tanı koymaz; ARFID rehberliği ve destek sunar.</div>
                    </div>
                </div>

                <!-- Chat Mesajları Akış Alanı (Mesajlar başlayınca görünür) -->
                <div class="chatArea" id="chatArea" style="display: none;">
                    <!-- Dinamik mesajlar buraya eklenecektir -->
                </div>
            </div>
        </main>
    </div>

    <script>
        // Sidebar Açma / Kapatma Mantığı (UI Katmanı)
        const sidebar = document.getElementById('sidebar');
        const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
        const sidebarOpenBtn = document.getElementById('sidebarOpenBtn');
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');
        const newChatBtn = document.getElementById('newChatBtn');
        
        const welcomeCenteredGroup = document.getElementById('welcomeCenteredGroup');
        const chatContainer = document.querySelector('.chatContainer');
        const messageInputContainer = document.getElementById('messageInputContainer');
        const chatArea = document.getElementById('chatArea');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');

        function openSidebar() {
            sidebar.classList.remove('collapsed');
            sidebarBackdrop.classList.add('active');
            sidebarOpenBtn.classList.remove('visible');
        }

        function closeSidebar() {
            sidebar.classList.add('collapsed');
            sidebarBackdrop.classList.remove('active');
            sidebarOpenBtn.classList.add('visible');
        }

        if (sidebarCloseBtn) {
            sidebarCloseBtn.addEventListener('click', closeSidebar);
        }
        if (sidebarOpenBtn) {
            sidebarOpenBtn.addEventListener('click', openSidebar);
        }
        if (sidebarBackdrop) {
            sidebarBackdrop.addEventListener('click', closeSidebar);
        }

        // ==========================================
        // AYARLAR (SETTINGS) MODAL ETKİLEŞİMİ
        // ==========================================
        const openSettingsBtn = document.getElementById('openSettingsBtn');
        const closeSettingsBtn = document.getElementById('closeSettingsBtn');
        const settingsModalOverlay = document.getElementById('settingsModalOverlay');
        const settingsModal = document.getElementById('settingsModal');
        const settingsSaveBtn = document.getElementById('settingsSaveBtn');
        const settingsNoticeText = document.getElementById('settingsNoticeText');

        function openSettingsModal() {
            if (settingsModalOverlay) {
                settingsModalOverlay.classList.add('active');
                if (settingsNoticeText) settingsNoticeText.textContent = '';
            }
        }

        function closeSettingsModal() {
            if (settingsModalOverlay) {
                settingsModalOverlay.classList.remove('active');
            }
        }

        if (openSettingsBtn) {
            openSettingsBtn.addEventListener('click', openSettingsModal);
        }
        if (closeSettingsBtn) {
            closeSettingsBtn.addEventListener('click', closeSettingsModal);
        }
        if (settingsModalOverlay) {
            settingsModalOverlay.addEventListener('click', function(e) {
                if (e.target === settingsModalOverlay) {
                    closeSettingsModal();
                }
            });
        }

        // Kaydet butonu (Backend güncelleme endpoint'i hazır olana kadar bilgilendirici UI bildirimi)
        if (settingsSaveBtn) {
            settingsSaveBtn.addEventListener('click', function() {
                if (settingsNoticeText) {
                    settingsNoticeText.textContent = 'Profil güncelleme özelliği henüz backend üzerinde aktif değildir.';
                    settingsNoticeText.style.color = '#FFA934';
                    setTimeout(() => {
                        if (settingsNoticeText) settingsNoticeText.textContent = '';
                    }, 4000);
                }
            });
        }

        // Karşılama Ekranı & Input Konum Durum Yönetimi (Boş/Dolu Sohbet)
        function checkWelcomeState() {
            const hasMessages = chatArea && chatArea.children.length > 0;
            if (hasMessages) {
                // Mesaj akış moduna geç: Ortalanmış karşılama grubunu gizle
                if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'none';
                if (chatArea) chatArea.style.display = 'flex';
                
                // Input barını chatContainer'ın altına taşı ve normal moda al
                if (messageInputContainer) {
                    messageInputContainer.classList.remove('heroMode');
                    chatContainer.appendChild(messageInputContainer);
                }
            } else {
                // Boş sohbet moduna geç: Ortalanmış grubu göster
                if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'flex';
                if (chatArea) chatArea.style.display = 'none';
                
                // Input barını ortalanmış grubun içine geri taşı
                if (messageInputContainer && welcomeCenteredGroup) {
                    messageInputContainer.classList.add('heroMode');
                    welcomeCenteredGroup.appendChild(messageInputContainer);
                }
            }
        }

        // Sayfa açıldığında başlangıç durumunu kontrol et
        checkWelcomeState();

        // Yeni Sohbet Butonu: Mevcut chat alanını temizleyip ortalanmış hoşgeldin ekranını geri getirir
        if (newChatBtn) {
            newChatBtn.addEventListener('click', () => {
                finishActiveTyping();
                removeLoading();
                chatArea.innerHTML = '';
                checkWelcomeState();
                messageInput.value = '';
                messageInput.focus();

                // Seçili olan sohbet kartındaki .active sınıfını kaldır
                activeConversationId = null;
                document.querySelectorAll('.historyItem.active').forEach(item => {
                    item.classList.remove('active');
                });

                // Mobilde sohbet başlatıldığında sidebar'ı kapat
                if (window.innerWidth <= 768) {
                    closeSidebar();
                }
            });
        }

        // ==========================================
        // SOHBET OTURUMLARI (CONVERSATION) YÖNETİMİ
        // ==========================================
        const chatHistorySection = document.getElementById('chatHistorySection');
        const searchInput = document.getElementById('searchInput');
        let allChatSessions = []; // Backend'den gelen konuşmalar [{ id, title, created_at, updated_at, is_pinned }]
        let activeConversationId = null;

        // Tarih formatlama yardımcısı (Bugün, Dün, Bu Hafta, Daha Eski)
        function getDateCategory(timestampSeconds) {
            if (!timestampSeconds) return "Daha Eski";
            const date = new Date(timestampSeconds * 1000);
            const now = new Date();
            
            const isToday = date.toDateString() === now.toDateString();
            if (isToday) return "Bugün";

            const yesterday = new Date();
            yesterday.setDate(now.getDate() - 1);
            if (date.toDateString() === yesterday.toDateString()) return "Dün";

            const sevenDaysAgo = new Date();
            sevenDaysAgo.setDate(now.getDate() - 7);
            if (date > sevenDaysAgo) return "Bu Hafta";

            return "Daha Eski";
        }

        // Sidebar'da Grupları Render Etme (Sabitlenenler en üstte, diğerleri tarih gruplarında)
        function renderSidebarHistory(filterQuery = '') {
            if (!chatHistorySection) return;
            chatHistorySection.innerHTML = '';

            const q = filterQuery.toLowerCase().trim();

            const filteredSessions = q
                ? allChatSessions.filter(s => (s.title || '').toLowerCase().includes(q))
                : allChatSessions;

            if (allChatSessions.length === 0) {
                chatHistorySection.innerHTML = `
                    <div class="historyEmptyState">
                        <span class="emptyIcon">🥑</span>
                        Henüz geçmiş bir sohbetiniz yok. Yeni bir soru sorarak başlayabilirsiniz!
                    </div>
                `;
                return;
            }

            if (filteredSessions.length === 0) {
                chatHistorySection.innerHTML = `
                    <div class="historyNotFound">
                        "${escapeHtml(filterQuery)}" ile eşleşen sohbet bulunamadı.
                    </div>
                `;
                return;
            }

            // Sabitlenenleri ve normal kategorileri ayrıştır
            const pinnedSessions = filteredSessions.filter(s => s.is_pinned === 1 || s.is_pinned === true);
            const regularSessions = filteredSessions.filter(s => !(s.is_pinned === 1 || s.is_pinned === true));

            // 1. Varsa Sabitlenenler Grubu Render Et
            if (pinnedSessions.length > 0) {
                renderGroupCategory("📌 Sabitlenenler", pinnedSessions);
            }

            // 2. Normal Tarih Gruplarını Render Et ("Bugün", "Dün", "Bu Hafta", "Daha Eski")
            const categories = {};
            regularSessions.forEach(sess => {
                const cat = sess.category || getDateCategory(sess.updated_at);
                if (!categories[cat]) {
                    categories[cat] = [];
                }
                categories[cat].push(sess);
            });

            // Bilinen sıralama düzeni
            const categoryOrder = ["Bugün", "Dün", "Bu Hafta", "Daha Eski"];
            categoryOrder.forEach(catName => {
                if (categories[catName] && categories[catName].length > 0) {
                    renderGroupCategory(catName, categories[catName]);
                }
            });

            // Listede olmayan başka bir kategori varsa ekle
            Object.keys(categories).forEach(catName => {
                if (!categoryOrder.includes(catName) && categories[catName].length > 0) {
                    renderGroupCategory(catName, categories[catName]);
                }
            });
        }

        // Tek bir kategori grubunu oluşturan yardımcı fonksiyon
        function renderGroupCategory(groupTitleText, sessionList) {
            const groupDiv = document.createElement('div');
            groupDiv.className = 'historyGroup';

            const titleDiv = document.createElement('div');
            titleDiv.className = 'groupTitle';
            titleDiv.textContent = groupTitleText;
            groupDiv.appendChild(titleDiv);

            sessionList.forEach(sess => {
                const isPinned = sess.is_pinned === 1 || sess.is_pinned === true;
                const itemDiv = document.createElement('div');
                itemDiv.className = 'historyItem';
                if (activeConversationId === sess.id) {
                    itemDiv.classList.add('active');
                }
                itemDiv.dataset.sessionId = sess.id;
                itemDiv.title = sess.title;

                itemDiv.innerHTML = `
                    <div class="historyItemLeft">
                        <span class="historyDot"></span>
                        ${isPinned ? '<span class="historyPinIcon" title="Sabitlendi">📌</span>' : ''}
                        <span class="historyTitle">${escapeHtml(sess.title)}</span>
                    </div>
                    <button type="button" class="historyItemMoreBtn" title="Seçenekler" aria-label="Seçenekler">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <circle cx="12" cy="5" r="2"></circle>
                            <circle cx="12" cy="12" r="2"></circle>
                            <circle cx="12" cy="19" r="2"></circle>
                        </svg>
                    </button>
                    <div class="historyDropdownMenu">
                        <button type="button" class="dropdownActionItem actionPin">
                            <span class="dropdownActionIcon">${isPinned ? '📍' : '📌'}</span>
                            <span>${isPinned ? 'Sabitlemeyi Kaldır' : 'Sohbeti Sabitle'}</span>
                        </button>
                        <button type="button" class="dropdownActionItem actionRename">
                            <span class="dropdownActionIcon">✏️</span>
                            <span>Yeniden Adlandır</span>
                        </button>
                        <button type="button" class="dropdownActionItem danger actionDelete">
                            <span class="dropdownActionIcon">🗑️</span>
                            <span>Sil</span>
                        </button>
                    </div>
                `;

                // Sohbete Tıklayınca Mesajları Yükleme
                itemDiv.addEventListener('click', (e) => {
                    // Eğer 3 nokta butonuna veya dropdown menüsüne tıklandıysa sohbet yükleme tetiklenmesin
                    if (e.target.closest('.historyItemMoreBtn') || e.target.closest('.historyDropdownMenu')) {
                        return;
                    }
                    loadConversationToChat(sess, itemDiv);
                });

                // 3 Nokta Butonu Etkileşimi
                const moreBtn = itemDiv.querySelector('.historyItemMoreBtn');
                const dropdownMenu = itemDiv.querySelector('.historyDropdownMenu');

                moreBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isAlreadyOpen = dropdownMenu.classList.contains('show');
                    closeAllDropdowns();
                    if (!isAlreadyOpen) {
                        dropdownMenu.classList.add('show');
                        moreBtn.classList.add('menuOpen');
                        itemDiv.classList.add('hasOpenMenu');
                        document.body.classList.add('hasOpenHistoryMenu');
                    }
                });

                // 1. Eylem: Sohbeti Sabitle / Sabitlemeyi Kaldır
                const pinBtn = itemDiv.querySelector('.actionPin');
                pinBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    togglePinSession(sess.id);
                });

                // 2. Eylem: Yeniden Adlandır
                const renameBtn = itemDiv.querySelector('.actionRename');
                renameBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    openRenameModalForSession(sess);
                });

                // 3. Eylem: Sil
                const deleteBtn = itemDiv.querySelector('.actionDelete');
                deleteBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    deleteSessionConfirmed(sess);
                });

                groupDiv.appendChild(itemDiv);
            });

            chatHistorySection.appendChild(groupDiv);
        }

        // Tüm açık dropdown menülerini kapat
        function closeAllDropdowns() {
            document.querySelectorAll('.historyDropdownMenu.show').forEach(menu => {
                menu.classList.remove('show');
            });
            document.querySelectorAll('.historyItemMoreBtn.menuOpen').forEach(btn => {
                btn.classList.remove('menuOpen');
            });
            document.querySelectorAll('.historyItem.hasOpenMenu, .savedWidgetItem.hasOpenMenu').forEach(item => {
                item.classList.remove('hasOpenMenu');
            });
            document.body.classList.remove('hasOpenHistoryMenu');
        }

        // Sayfada başka bir yere tıklandığında açık olan 3 nokta menülerini kapat
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.historyItemMoreBtn') && !e.target.closest('.historyDropdownMenu')) {
                closeAllDropdowns();
            }
        });

        // Sohbeti Sabitleme Mantığı
        async function togglePinSession(sessionId) {
            try {
                const response = await fetch(`/chat/conversations/${sessionId}/pin`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    await fetchAndInitializeHistory();
                }
            } catch (err) {
                console.error("Pin değiştirilemedi:", err);
            }
        }

        // ==========================================
        // YENİDEN ADLANDIRMA MODAL YÖNETİMİ
        // ==========================================
        const renameModalOverlay = document.getElementById('renameModalOverlay');
        const renameModalInput = document.getElementById('renameModalInput');
        const renameCancelBtn = document.getElementById('renameCancelBtn');
        const renameSaveBtn = document.getElementById('renameSaveBtn');
        let sessionToRename = null;

        function openRenameModalForSession(sess) {
            sessionToRename = sess;
            if (renameModalInput) {
                renameModalInput.value = sess.title;
            }
            if (renameModalOverlay) {
                renameModalOverlay.classList.add('active');
                setTimeout(() => {
                    if (renameModalInput) {
                        renameModalInput.focus();
                        renameModalInput.select();
                    }
                }, 50);
            }
        }

        function closeRenameModal() {
            if (renameModalOverlay) {
                renameModalOverlay.classList.remove('active');
            }
            sessionToRename = null;
        }

        async function saveSessionRename() {
            if (!sessionToRename || !renameModalInput) return;
            const newTitle = renameModalInput.value.trim();
            if (!newTitle) return;

            try {
                const response = await fetch(`/chat/conversations/${sessionToRename.id}/rename`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: newTitle })
                });

                if (response.ok) {
                    closeRenameModal();
                    await fetchAndInitializeHistory();
                } else {
                    alert("Sohbet adı güncellenemedi.");
                }
            } catch (err) {
                console.error("Yeniden adlandırma hatası:", err);
                alert("Bağlantı hatası.");
            }
        }

        if (renameCancelBtn) {
            renameCancelBtn.addEventListener('click', closeRenameModal);
        }
        if (renameSaveBtn) {
            renameSaveBtn.addEventListener('click', saveSessionRename);
        }
        if (renameModalOverlay) {
            renameModalOverlay.addEventListener('click', (e) => {
                if (e.target === renameModalOverlay) {
                    closeRenameModal();
                }
            });
        }
        if (renameModalInput) {
            renameModalInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    saveSessionRename();
                }
            });
        }

        // ==========================================
        // SOHBETİ SİLME EYLEMİ
        // ==========================================
        async function deleteSessionConfirmed(session) {
            const isConfirmed = confirm(`"${session.title}" adlı sohbeti silmek istediğinize emin misiniz?`);
            if (!isConfirmed) return;

            try {
                const response = await fetch(`/chat/conversations/${session.id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    if (activeConversationId === session.id) {
                        activeConversationId = null;
                        finishActiveTyping();
                        removeLoading();
                        chatArea.innerHTML = '';
                        checkWelcomeState();
                    }

                    await fetchAndInitializeHistory();
                } else {
                    const errData = await response.json().catch(() => ({}));
                    alert(errData.error || "Sohbet silinirken bir hata oluştu.");
                }
            } catch (err) {
                console.error("Sohbet silme hatası:", err);
                alert("Sunucu ile iletişim kurulurken bir hata oluştu.");
            }
        }

        // Tıklanan Konuşmayı Chat Ekranına Yükleme
        async function loadConversationToChat(session, activeElement) {
            finishActiveTyping();
            removeLoading();

            activeConversationId = session.id;

            // .active sınıfını güncelle
            document.querySelectorAll('.historyItem.active').forEach(el => el.classList.remove('active'));
            if (activeElement) {
                activeElement.classList.add('active');
            }

            // Ekranı temizle
            chatArea.innerHTML = '';
            
            if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'none';
            if (chatArea) chatArea.style.display = 'flex';
            if (messageInputContainer) {
                messageInputContainer.classList.remove('heroMode');
                chatContainer.appendChild(messageInputContainer);
            }

            try {
                const response = await fetch(`/chat/conversations/${session.id}/messages`);
                if (!response.ok) throw new Error("Mesajlar alınamadı");
                const data = await response.json();
                const messages = data.messages || [];

                if (activeConversationId !== session.id) return;

                messages.forEach(msg => {
                    const messageDiv = document.createElement('div');
                    if (msg.id) {
                        messageDiv.dataset.messageId = msg.id;
                    }
                    if (msg.role === 'user') {
                        messageDiv.className = 'userMessage';
                        messageDiv.innerHTML = `<div class="userMessageBubble">${escapeHtml(msg.content.trim())}</div>`;
                    } else {
                        messageDiv.className = 'welcomeMessage';
                        messageDiv.innerHTML = `
                            <div class="aiAvatar">
                                <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                            </div>
                            <div class="aiResponseContent">
                                <div class="aiMessageBubble">${escapeHtml(msg.content.trim())}</div>
                            </div>
                        `;
                        if (msg.widget) {
                            const widgetEl = renderWidgetDOM(msg.widget);
                            if (widgetEl) {
                                messageDiv.querySelector('.aiResponseContent').appendChild(widgetEl);
                            }
                        }
                    }
                    chatArea.appendChild(messageDiv);
                });

                chatArea.scrollTop = chatArea.scrollHeight;
            } catch (err) {
                console.error("Mesaj yükleme hatası:", err);
                chatArea.innerHTML = '<div class="historyNotFound">Sohbet mesajları yüklenirken bir hata oluştu.</div>';
            }

            if (window.innerWidth <= 768) {
                closeSidebar();
            }
        }

        // Backend'den Konuşma Listesini Çekip Başlatma
        async function fetchAndInitializeHistory() {
            try {
                const response = await fetch('/chat/conversations');
                if (response.ok) {
                    const data = await response.json();
                    const conversations = data.conversations || [];
                    allChatSessions = conversations.map(c => ({
                        ...c,
                        category: getDateCategory(c.updated_at)
                    }));
                    renderSidebarHistory(searchInput ? searchInput.value : '');
                } else {
                    renderSidebarHistory(searchInput ? searchInput.value : '');
                }
            } catch (err) {
                console.error("Geçmiş sohbetler yüklenemedi:", err);
                renderSidebarHistory(searchInput ? searchInput.value : '');
            }
        }

        // ==========================================
        // SİDEBAR SEKMELERİ & KAYITLI TARİFLERİM (Aşama D)
        // ==========================================
        const tabChatsBtn = document.getElementById('tabChatsBtn');
        const tabRecipesBtn = document.getElementById('tabRecipesBtn');
        const recipesBadge = document.getElementById('recipesBadge');
        const savedWidgetsSection = document.getElementById('savedWidgetsSection');
        let activeSidebarTab = 'chats'; // 'chats' veya 'recipes'
        let allSavedWidgets = [];

        function switchSidebarTab(tabName) {
            activeSidebarTab = tabName;
            if (tabName === 'chats') {
                if (tabChatsBtn) tabChatsBtn.classList.add('active');
                if (tabRecipesBtn) tabRecipesBtn.classList.remove('active');
                if (chatHistorySection) chatHistorySection.style.display = 'block';
                if (savedWidgetsSection) savedWidgetsSection.style.display = 'none';
                if (searchInput) {
                    searchInput.placeholder = 'Sohbetlerde ara...';
                    renderSidebarHistory(searchInput.value);
                }
            } else if (tabName === 'recipes') {
                if (tabRecipesBtn) tabRecipesBtn.classList.add('active');
                if (tabChatsBtn) tabChatsBtn.classList.remove('active');
                if (chatHistorySection) chatHistorySection.style.display = 'none';
                if (savedWidgetsSection) savedWidgetsSection.style.display = 'flex';
                if (searchInput) {
                    searchInput.placeholder = 'Tarifler ve besinlerde ara...';
                    renderSavedWidgets(searchInput.value);
                }
            }
        }

        if (tabChatsBtn) {
            tabChatsBtn.addEventListener('click', () => switchSidebarTab('chats'));
        }
        if (tabRecipesBtn) {
            tabRecipesBtn.addEventListener('click', () => switchSidebarTab('recipes'));
        }

        // Backend'den Kayıtlı Widget'ları (Tarif & Besin) Çekme
        async function fetchAndRenderSavedWidgets() {
            try {
                const response = await fetch('/widgets/saved');
                if (response.ok) {
                    const data = await response.json();
                    const rawWidgets = data.widgets || [];
                    allSavedWidgets = rawWidgets.map(w => ({
                        id: w.id,
                        type: w.widget_type || w.type || 'recipe',
                        title: w.title,
                        data: w.widget_data || w.data || {},
                        conversation_id: w.conversation_id,
                        related_message_id: w.related_message_id,
                        is_pinned: w.is_pinned === 1 || w.is_pinned === true,
                        created_at: w.created_at
                    }));
                    if (recipesBadge) {
                        recipesBadge.textContent = allSavedWidgets.length;
                    }
                    if (activeSidebarTab === 'recipes') {
                        renderSavedWidgets(searchInput ? searchInput.value : '');
                    }
                }
            } catch (err) {
                console.error("Kayıtlı tarifler yüklenemedi:", err);
            }
        }

        // Kayıtlı Widget'ları Sidebar'da Listeleme (Sekmeye özel izole arama filtresiyle)
        function renderSavedWidgets(filterQuery = '') {
            if (!savedWidgetsSection) return;
            savedWidgetsSection.innerHTML = '';

            const q = filterQuery.toLowerCase().trim();
            const filtered = q
                ? allSavedWidgets.filter(w => {
                    const title = (w.title || '').toLowerCase();
                    const type = (w.type || '').toLowerCase();
                    const note = (w.data && (w.data.food_name || w.data.dietitian_note || '')) ? String(w.data.food_name || w.data.dietitian_note).toLowerCase() : '';
                    return title.includes(q) || type.includes(q) || note.includes(q);
                })
                : allSavedWidgets;

            if (allSavedWidgets.length === 0) {
                savedWidgetsSection.innerHTML = `
                    <div class="historyEmptyState">
                        <span class="emptyIcon">🍲</span>
                        Henüz kayıtlı bir tarif veya besin kartınız yok. Sohbet esnasında üretilen kartlar burada toplanır!
                    </div>
                `;
                return;
            }

            if (filtered.length === 0) {
                savedWidgetsSection.innerHTML = `
                    <div class="historyNotFound">
                        "${escapeHtml(filterQuery)}" ile eşleşen tarif bulunamadı.
                    </div>
                `;
                return;
            }

            filtered.forEach(w => {
                const isPinned = w.is_pinned === 1 || w.is_pinned === true;
                const itemDiv = document.createElement('div');
                itemDiv.className = 'savedWidgetItem' + (isPinned ? ' isPinned' : '');
                itemDiv.dataset.widgetId = w.id;

                const isRecipe = w.type === 'recipe';
                const icon = isRecipe ? '🍲' : '🥗';
                const typeLabel = isRecipe ? 'Tarif' : 'Besin Özeti';
                const title = escapeHtml(w.title || (isRecipe ? 'Yemek Tarifi' : 'Besin Özeti'));
                
                let metaText = '';
                if (isRecipe && w.data) {
                    const time = (w.data.prep_time_min || 10) + (w.data.cook_time_min || 20);
                    metaText = `⏱️ ${time} dk ${w.data.calories_approx ? `• ~${w.data.calories_approx} kcal` : ''}`;
                } else if (w.data && w.data.total_calories) {
                    metaText = `⚡ ${w.data.total_calories} kcal • ${escapeHtml(w.data.amount_label || 'Porsiyon')}`;
                }

                const dateStr = w.created_at
                    ? new Date(w.created_at * 1000).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' })
                    : '';

                itemDiv.innerHTML = `
                    <div class="savedWidgetTopRow">
                        <span class="savedWidgetIcon">${icon}</span>
                        <div class="savedWidgetInfo">
                            <div class="savedWidgetTitleRow">
                                ${isPinned ? '<span class="savedWidgetPinIcon" title="Sabitlendi">📌</span>' : ''}
                                <span class="savedWidgetTitle">${title}</span>
                            </div>
                            <div class="savedWidgetMeta">
                                <span class="savedWidgetMetaTag">${typeLabel}</span>
                                ${metaText ? `<span>${metaText}</span>` : ''}
                            </div>
                        </div>
                        <button type="button" class="historyItemMoreBtn savedWidgetMoreBtn" title="Seçenekler" aria-label="Seçenekler">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                <circle cx="12" cy="5" r="2"></circle>
                                <circle cx="12" cy="12" r="2"></circle>
                                <circle cx="12" cy="19" r="2"></circle>
                            </svg>
                        </button>
                        <div class="historyDropdownMenu savedWidgetDropdownMenu">
                            <button type="button" class="dropdownActionItem actionPinWidget">
                                <span class="dropdownActionIcon">${isPinned ? '📍' : '📌'}</span>
                                <span>${isPinned ? 'Sabitlemeyi Kaldır' : 'Tarifi Sabitle'}</span>
                            </button>
                            <button type="button" class="dropdownActionItem danger actionDeleteWidget">
                                <span class="dropdownActionIcon">🗑️</span>
                                <span>Tarifi Sil</span>
                            </button>
                        </div>
                    </div>
                    <div class="savedWidgetBottomRow">
                        <span class="savedWidgetDate">${dateStr}</span>
                        ${(w.conversation_id && w.related_message_id) ? `
                            <button type="button" class="savedWidgetJumpBtn" data-conv-id="${w.conversation_id}" data-msg-id="${w.related_message_id}">
                                <span>Bu Sohbete Git</span>
                                <span>↗</span>
                            </button>
                        ` : ''}
                    </div>
                `;

                // Kartın geneline tıklanınca Stage C modalı açılsın
                itemDiv.addEventListener('click', (e) => {
                    if (e.target.closest('.savedWidgetMoreBtn') || e.target.closest('.historyDropdownMenu') || e.target.closest('.savedWidgetJumpBtn')) return;
                    openWidgetDetailModal(w);
                });

                // 3 Nokta Butonu Etkileşimi
                const moreBtn = itemDiv.querySelector('.savedWidgetMoreBtn');
                const dropdownMenu = itemDiv.querySelector('.savedWidgetDropdownMenu');

                moreBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const isAlreadyOpen = dropdownMenu.classList.contains('show');
                    closeAllDropdowns();
                    if (!isAlreadyOpen) {
                        dropdownMenu.classList.add('show');
                        moreBtn.classList.add('menuOpen');
                        itemDiv.classList.add('hasOpenMenu');
                    }
                });

                // 1. Eylem: Sabitle / Sabitlemeyi Kaldır
                const pinBtn = itemDiv.querySelector('.actionPinWidget');
                pinBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    togglePinWidget(w.id);
                });

                // 2. Eylem: Sil
                const deleteBtn = itemDiv.querySelector('.actionDeleteWidget');
                deleteBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    closeAllDropdowns();
                    deleteWidgetConfirmed(w);
                });

                // "Bu Sohbete Git" butonuna tıklanınca o konuşmaya ve mesaja atla
                const jumpBtn = itemDiv.querySelector('.savedWidgetJumpBtn');
                if (jumpBtn) {
                    jumpBtn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        const convId = parseInt(jumpBtn.dataset.convId, 10);
                        const msgId = parseInt(jumpBtn.dataset.msgId, 10);
                        jumpToConversationMessage(convId, msgId);
                    });
                }

                savedWidgetsSection.appendChild(itemDiv);
            });
        }

        // Kayıtlı Tarifi Sabitleme Mantığı
        async function togglePinWidget(widgetId) {
            try {
                const response = await fetch(`/widgets/saved/${widgetId}/pin`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' }
                });
                if (response.ok) {
                    await fetchAndRenderSavedWidgets();
                } else {
                    alert("Sabitleme durumu değiştirilemedi.");
                }
            } catch (err) {
                console.error("Tarif sabitleme hatası:", err);
            }
        }

        // Kayıtlı Tarifi Silme Mantığı
        async function deleteWidgetConfirmed(widget) {
            const isConfirmed = confirm(`"${widget.title || 'Bu tarif'}" kaydını silmek istediğinize emin misiniz?`);
            if (!isConfirmed) return;

            try {
                const response = await fetch(`/widgets/saved/${widget.id}`, {
                    method: 'DELETE'
                });
                if (response.ok) {
                    await fetchAndRenderSavedWidgets();
                } else {
                    const errData = await response.json().catch(() => ({}));
                    alert(errData.error || "Tarif silinirken bir hata oluştu.");
                }
            } catch (err) {
                console.error("Tarif silme hatası:", err);
                alert("Sunucu ile iletişim kurulurken bir hata oluştu.");
            }
        }

        // Belirli bir sohbetteki belirli mesaja atlama ve vurgulama
        async function jumpToConversationMessage(conversationId, messageId) {
            // 1. Sohbetler sekmesine geç
            switchSidebarTab('chats');

            // 2. İlgili session objesini ve DOM elemanını bul
            const session = allChatSessions.find(s => s.id === conversationId) || { id: conversationId, title: "Sohbet" };
            const historyItemEl = document.querySelector(`.historyItem[data-session-id="${conversationId}"]`);

            // 3. Konuşmayı yükle
            await loadConversationToChat(session, historyItemEl);

            // 4. İlgili mesaja yumuşakça kaydır ve vurgula
            setTimeout(() => {
                const msgEl = document.querySelector(`[data-message-id="${messageId}"]`);
                if (msgEl) {
                    msgEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    msgEl.classList.remove('highlightMessage');
                    void msgEl.offsetWidth; // Reflow tetikle
                    msgEl.classList.add('highlightMessage');
                    setTimeout(() => {
                        msgEl.classList.remove('highlightMessage');
                    }, 3000);
                }
            }, 180);
        }

        // Arama kutusu - Aktif sekmeye göre İZOLE filtreleme yapar
        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                const query = e.target.value;
                if (activeSidebarTab === 'chats') {
                    renderSidebarHistory(query);
                } else if (activeSidebarTab === 'recipes') {
                    renderSavedWidgets(query);
                }
            });
        }

        // Sayfa açılışında hem sohbet geçmişini hem de kayıtlı tarifleri getir
        fetchAndInitializeHistory();
        fetchAndRenderSavedWidgets();

        // ==========================================
        // MEVCUT MESAJLAŞMA & FONKSİYONEL JS MANTIĞI
        // ==========================================
        let currentLoadingBubble = null;
        let activeTypingInterval = null;
        let activeTypingBubble = null;
        let activeTypingFullText = '';
        const TYPING_SPEED_MS = 25; // 25ms per character / speed config

        function finishActiveTyping() {
            if (activeTypingInterval) {
                clearInterval(activeTypingInterval);
                activeTypingInterval = null;
            }
            if (activeTypingBubble && activeTypingFullText) {
                activeTypingBubble.textContent = activeTypingFullText;
                activeTypingBubble = null;
                activeTypingFullText = '';
            }
        }

        function showLoading() {
            if (currentLoadingBubble) return;

            const messageDiv = document.createElement('div');
            messageDiv.className = 'welcomeMessage';
            messageDiv.id = 'loadingIndicator';
            messageDiv.innerHTML = `
                <div class="aiAvatar">
                    <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                </div>
                <div class="aiMessageBubble aiLoadingBubble">
                    <div class="loadingBubble">
                        <span class="loadingText">Düşünüyor...</span>
                        <div class="typingDots">
                            <div class="dot"></div>
                            <div class="dot"></div>
                            <div class="dot"></div>
                        </div>
                    </div>
                </div>
            `;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
            currentLoadingBubble = messageDiv;
        }

        function removeLoading() {
            if (currentLoadingBubble) {
                currentLoadingBubble.remove();
                currentLoadingBubble = null;
            }
        }

        function addUserMessage(message) {
            finishActiveTyping();
            
            // İlk mesaj gönderildiğinde karşılama ekranını kaldır ve input'u alt konuma taşı
            if (welcomeCenteredGroup && welcomeCenteredGroup.style.display !== 'none') {
                welcomeCenteredGroup.style.display = 'none';
                chatArea.style.display = 'flex';
                messageInputContainer.classList.remove('heroMode');
                chatContainer.appendChild(messageInputContainer);
            }

            const messageDiv = document.createElement('div');
            messageDiv.className = 'userMessage';
            messageDiv.innerHTML = `<div class="userMessageBubble">${escapeHtml(message.trim())}</div>`;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // ==========================================
        // WIDGET RENDER SİSTEMİ (Aşama B)
        // ==========================================
        function renderWidgetDOM(widget) {
            if (!widget || typeof widget !== 'object') return null;

            const container = document.createElement('div');
            container.className = 'widgetContainer';
            container.dataset.widgetType = widget.type || 'recipe';

            const data = widget.data || {};
            const title = escapeHtml(widget.title || 'Bilgi Kartı');

            if (widget.type === 'recipe') {
                const isCompact = data.display_mode === 'compact_list';
                if (isCompact) {
                    container.classList.add('widgetRecipeCompact');
