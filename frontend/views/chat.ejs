        // ==========================================
        // AYARLAR MODALI: SEKME GEÇİŞLERİ & BESLENME PROFİLİ
        // ==========================================
        const settingsTabProfile = document.getElementById('settingsTabProfile');
        const settingsTabDietary = document.getElementById('settingsTabDietary');
        const settingsPaneProfile = document.getElementById('settingsPaneProfile');
        const settingsPaneDietary = document.getElementById('settingsPaneDietary');
        const dietaryLoadingState = document.getElementById('dietaryLoadingState');
        const dietaryContentContainer = document.getElementById('dietaryContentContainer');
        const dietaryEditBtn = document.getElementById('dietaryEditBtn');
        const dietaryEditBtnText = document.getElementById('dietaryEditBtnText');

        const dietaryConfirmOverlay = document.getElementById('dietaryConfirmOverlay');
        const dietaryConfirmMessage = document.getElementById('dietaryConfirmMessage');
        const dietaryConfirmCancelBtn = document.getElementById('dietaryConfirmCancelBtn');
        const dietaryConfirmDeleteBtn = document.getElementById('dietaryConfirmDeleteBtn');

        const safeFoodsList = document.getElementById('safeFoodsList');
        const unsafeFoodsList = document.getElementById('unsafeFoodsList');
        const sensoryTriggersList = document.getElementById('sensoryTriggersList');

        const safeFoodsCount = document.getElementById('safeFoodsCount');
        const unsafeFoodsCount = document.getElementById('unsafeFoodsCount');
        const sensoryTriggersCount = document.getElementById('sensoryTriggersCount');

        let isDietaryEditMode = false;
        let pendingDietaryDeletion = null;

        const DIETARY_I18N = {
            emptySafe: '<%= t("chat.empty_safe_foods") %>',
            emptyUnsafe: '<%= t("chat.empty_avoided_foods") %>',
            emptySensory: '<%= t("chat.empty_sensory_triggers") %>',
            deleteTitle: '<%= t("chat.delete") %>',
            edit: '<%= t("chat.edit") %>',
            done: '<%= t("chat.done") %>',
            confirmSuffix: '<%= t("chat.delete_dietary_confirm_suffix") %>'
        };

        function toggleDietaryEditMode(forceState) {
            isDietaryEditMode = (typeof forceState === 'boolean') ? forceState : !isDietaryEditMode;
            if (isDietaryEditMode) {
                if (dietaryContentContainer) dietaryContentContainer.classList.add('editMode');
                if (dietaryEditBtn) dietaryEditBtn.classList.add('active');
                if (dietaryEditBtnText) dietaryEditBtnText.textContent = DIETARY_I18N.done;
            } else {
                if (dietaryContentContainer) dietaryContentContainer.classList.remove('editMode');
                if (dietaryEditBtn) dietaryEditBtn.classList.remove('active');
                if (dietaryEditBtnText) dietaryEditBtnText.textContent = DIETARY_I18N.edit;
            }
        }

        if (dietaryEditBtn) {
            dietaryEditBtn.addEventListener('click', () => toggleDietaryEditMode());
        }

        function openDietaryConfirmModal(item, type, tagEl, containerEl, countEl, emptyMessage) {
            pendingDietaryDeletion = { id: item.id, type, tagEl, containerEl, countEl, emptyMessage };
            if (dietaryConfirmMessage) {
                dietaryConfirmMessage.textContent = '';
                const boldName = document.createElement('strong');
                boldName.textContent = `"${item.name}"`;
                dietaryConfirmMessage.appendChild(boldName);
                dietaryConfirmMessage.appendChild(document.createTextNode(' ' + DIETARY_I18N.confirmSuffix));
            }
            if (dietaryConfirmOverlay) {
                dietaryConfirmOverlay.classList.add('active');
            }
        }

        function closeDietaryConfirmModal() {
            pendingDietaryDeletion = null;
            if (dietaryConfirmOverlay) {
                dietaryConfirmOverlay.classList.remove('active');
            }
        }

        if (dietaryConfirmCancelBtn) {
            dietaryConfirmCancelBtn.addEventListener('click', closeDietaryConfirmModal);
        }

        if (dietaryConfirmDeleteBtn) {
            dietaryConfirmDeleteBtn.addEventListener('click', async () => {
                if (!pendingDietaryDeletion) return;
                const { id, type, tagEl, containerEl, countEl, emptyMessage } = pendingDietaryDeletion;
                closeDietaryConfirmModal();
                await executeDietaryItemDeletion(id, type, tagEl, containerEl, countEl, emptyMessage);
            });
        }

        if (dietaryConfirmOverlay) {
            dietaryConfirmOverlay.addEventListener('click', (e) => {
                if (e.target === dietaryConfirmOverlay) {
                    closeDietaryConfirmModal();
                }
            });
        }

        function switchSettingsTab(tabName) {
            if (tabName === 'profile') {
                if (settingsTabProfile) settingsTabProfile.classList.add('active');
                if (settingsTabDietary) settingsTabDietary.classList.remove('active');
                if (settingsPaneProfile) settingsPaneProfile.classList.add('active');
                if (settingsPaneDietary) settingsPaneDietary.classList.remove('active');
                toggleDietaryEditMode(false);
                closeDietaryConfirmModal();
            } else if (tabName === 'dietary') {
                if (settingsTabDietary) settingsTabDietary.classList.add('active');
                if (settingsTabProfile) settingsTabProfile.classList.remove('active');
                if (settingsPaneDietary) settingsPaneDietary.classList.add('active');
                if (settingsPaneProfile) settingsPaneProfile.classList.remove('active');
                toggleDietaryEditMode(false);
                closeDietaryConfirmModal();
                fetchAndRenderDietaryProfile();
            }
        }

        if (settingsTabProfile) {
            settingsTabProfile.addEventListener('click', () => switchSettingsTab('profile'));
        }
        if (settingsTabDietary) {
            settingsTabDietary.addEventListener('click', () => switchSettingsTab('dietary'));
        }

        async function fetchAndRenderDietaryProfile() {
            if (!dietaryLoadingState || !dietaryContentContainer) return;
            dietaryLoadingState.style.display = 'flex';
            dietaryContentContainer.style.display = 'none';

            try {
                const response = await fetch('/user/dietary-profile');
                if (!response.ok) throw new Error('HTTP ' + response.status);
                const data = await response.json();

                renderDietaryCategory(safeFoodsList, safeFoodsCount, data.safeFoods || [], 'safe', DIETARY_I18N.emptySafe);
                renderDietaryCategory(unsafeFoodsList, unsafeFoodsCount, data.unsafeFoods || [], 'unsafe', DIETARY_I18N.emptyUnsafe);
                renderDietaryCategory(sensoryTriggersList, sensoryTriggersCount, data.sensoryTriggers || [], 'sensory', DIETARY_I18N.emptySensory);
            } catch (err) {
                console.error('Beslenme profili alınamadı:', err);
                renderDietaryCategory(safeFoodsList, safeFoodsCount, [], 'safe', DIETARY_I18N.emptySafe);
                renderDietaryCategory(unsafeFoodsList, unsafeFoodsCount, [], 'unsafe', DIETARY_I18N.emptyUnsafe);
                renderDietaryCategory(sensoryTriggersList, sensoryTriggersCount, [], 'sensory', DIETARY_I18N.emptySensory);
            } finally {
                dietaryLoadingState.style.display = 'none';
                dietaryContentContainer.style.display = 'block';
            }
        }

        function renderDietaryCategory(containerEl, countEl, items, type, emptyMessage) {
            if (!containerEl) return;
            containerEl.innerHTML = '';
            if (countEl) countEl.textContent = items.length;

            if (!items || items.length === 0) {
                const emptySpan = document.createElement('span');
                emptySpan.className = 'dietaryEmptyText';
                emptySpan.textContent = emptyMessage;
                containerEl.appendChild(emptySpan);
                return;
            }

            items.forEach(item => {
                const tagEl = document.createElement('div');
                tagEl.className = 'dietaryTag ' + type;
                tagEl.dataset.id = item.id;
                tagEl.dataset.type = type;

                const textSpan = document.createElement('span');
                textSpan.className = 'dietaryTagText';
                textSpan.textContent = item.name;

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'dietaryTagRemoveBtn';
                removeBtn.title = DIETARY_I18N.deleteTitle;
                removeBtn.setAttribute('aria-label', DIETARY_I18N.deleteTitle);
                removeBtn.textContent = '✕';

                removeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    openDietaryConfirmModal(item, type, tagEl, containerEl, countEl, emptyMessage);
                });

                tagEl.appendChild(textSpan);
                tagEl.appendChild(removeBtn);
                containerEl.appendChild(tagEl);
            });
        }

        async function executeDietaryItemDeletion(id, type, tagEl, containerEl, countEl, emptyMessage) {
            try {
                let url = '';
                if (type === 'safe' || type === 'unsafe') {
                    url = `/user/dietary-profile/food/${encodeURIComponent(id)}`;
                } else if (type === 'sensory') {
                    url = `/user/dietary-profile/sensory/${encodeURIComponent(id)}`;
                }
                if (!url) return;

                tagEl.style.opacity = '0.4';
                tagEl.style.pointerEvents = 'none';

                const response = await fetch(url, { method: 'DELETE' });
                const result = await response.json();

                if (response.ok && result.success) {
                    tagEl.remove();
                    if (countEl) {
                        const current = parseInt(countEl.textContent || '0', 10);
                        const updated = Math.max(0, current - 1);
                        countEl.textContent = updated;
                        if (updated === 0 && containerEl) {
                            const emptySpan = document.createElement('span');
                            emptySpan.className = 'dietaryEmptyText';
                            emptySpan.textContent = emptyMessage;
                            containerEl.appendChild(emptySpan);
                        }
                    }
                } else {
                    tagEl.style.opacity = '1';
                    tagEl.style.pointerEvents = 'auto';
                    alert(result.error || 'Öğe silinemedi.');
                }
            } catch (err) {
                console.error('Silme işlemi hatası:', err);
                tagEl.style.opacity = '1';
                tagEl.style.pointerEvents = 'auto';
            }
        }

        // Karşılama Ekranı & Input Konum Durum Yönetimi (Boş/Dolu Sohbet)
        function checkWelcomeState() {
            const hasMessages = chatArea && chatArea.children.length > 0;
            if (hasMessages) {
                // Mesaj akış moduna geç: Ortalanmış karşılama grubunu gizle
                if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'none';
                if (chatArea) chatArea.style.display = 'flex';
                
                // Input barını chatContainer'ın altına taşı ve normal moda al
                if (messageInputContainer) {
                    messageInputContainer.classList.remove('heroMode');
                    chatContainer.appendChild(messageInputContainer);
                }
            } else {
                // Boş sohbet moduna geç: Ortalanmış grubu göster
                if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'flex';
                if (chatArea) chatArea.style.display = 'none';
                
                // Input barını ortalanmış grubun içine geri taşı
                if (messageInputContainer && welcomeCenteredGroup) {
                    messageInputContainer.classList.add('heroMode');
                    welcomeCenteredGroup.appendChild(messageInputContainer);
                }
            }
        }

        // Sayfa açıldığında başlangıç durumunu kontrol et
        checkWelcomeState();

        // Yeni Sohbet Butonu: Mevcut chat alanını temizleyip ortalanmış hoşgeldin ekranını geri getirir
        if (newChatBtn) {
            newChatBtn.addEventListener('click', () => {
                finishActiveTyping();
                removeLoading();
                chatArea.innerHTML = '';
                checkWelcomeState();
                messageInput.value = '';
                messageInput.focus();

                // Seçili olan sohbet kartındaki .active sınıfını kaldır
                activeConversationId = null;
                document.querySelectorAll('.historyItem.active').forEach(item => {
                    item.classList.remove('active');
