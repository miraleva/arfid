<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARFID Asistanı - Sohbet</title>
    
    <link rel="stylesheet" href="chat.css">
    <link rel="stylesheet" href="settings.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap"/>
</head>
<body>
    <div class="appContainer">
        <!-- Sol Claude Tarzı Sidebar (Beyaz Arkaplan) -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebarHeader">
                <div class="brand">
                    <div class="brandLogo">
                        <img src="/image/arfid_icon.png" alt="Asistancım Logo" class="brandIconImg">
                    </div>
                    <span class="brandText">Asistancım</span>
                </div>
                <button class="sidebarCloseBtn" id="sidebarCloseBtn" title="Sidebar'ı Kapat" aria-label="Sidebar'ı Kapat">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
            </div>

            <!-- 1. Üst Kısım: Yeni Sohbet Butonu (Flat Renk + Glow) -->
            <div class="newChatSection">
                <button class="newChatBtn" id="newChatBtn">
                    <span class="newChatIcon">+</span>
                    <span>Yeni Sohbet</span>
                </button>
            </div>

            <!-- 2. Arama Kutusu (UI Placeholder) -->
            <div class="searchSection">
                <div class="searchInputWrapper">
                    <svg class="searchIcon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" class="searchInput" placeholder="Sohbetlerde ara..." aria-label="Sohbetlerde ara" />
                </div>
            </div>

            <!-- 3. Geçmiş Sohbetler Listesi Alanı -->
            <div class="chatHistorySection" id="chatHistorySection">
                <!-- Gerçek çoklu-sohbet verisi bağlandığında dinamik olarak listelenecektir -->
            </div>

            <!-- 4. Alt Kısım: Profil, Ayarlar ve Logout Alanı -->
            <div class="sidebarFooter">
                <div class="userProfile">
                    <div class="userAvatar">
                        <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                    </div>
                    <div class="userInfo">
                        <div class="userName">
                            <%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Kullanıcı' %>
                        </div>
                    </div>
                </div>

                <div class="sidebarActions">
                    <!-- Ayarlar Butonu (⚙️ Settings İkonu) -->
                    <button class="settingsBtn" id="openSettingsBtn" title="Ayarlar" aria-label="Ayarlar">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </button>

                    <!-- Çıkış Butonu -->
                    <a href="/logout" class="logoutLink" title="Çıkış Yap" aria-label="Çıkış Yap">
                        <button class="logoutBtn" type="button">
                            <svg class="logoutIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span class="logoutText">Çıkış</span>
                        </button>
                    </a>
                </div>
            </div>
        </aside>

        <!-- Claude Tarzı Settings Modal Pop-up -->
        <div class="settingsModalOverlay" id="settingsModalOverlay">
            <div class="settingsModal" id="settingsModal">
                <div class="settingsModalHeader">
                    <div class="settingsModalTitle">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                        <span>Ayarlar</span>
                    </div>
                    <button class="settingsCloseBtn" id="closeSettingsBtn" title="Kapat" aria-label="Kapat">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>

                <div class="settingsModalBody">
                    <!-- Sol Panel (Dar Dikey Menü) -->
                    <div class="settingsSidebar">
                        <button class="settingsTabItem active" type="button">
                            <svg class="settingsTabIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <span>Profil</span>
                        </button>
                    </div>

                    <!-- Sağ Panel (Geniş İçerik Alanı) -->
                    <div class="settingsContent">
                        <h2 class="settingsSectionTitle">Profil Bilgileri</h2>
                        <p class="settingsSectionDesc">Hesap bilgilerinizi ve asistan tercihlerinizi buradan görüntüleyebilirsiniz.</p>

                        <div class="settingsAvatarRow">
                            <div class="settingsAvatarLarge">
                                <%= (typeof user !== 'undefined' && user && user.username) ? user.username.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div class="settingsAvatarInfo">
                                <span class="settingsAvatarLabel"><%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Kullanıcı' %></span>
                                <span class="settingsAvatarSub">Profil Avatarı</span>
                            </div>
                        </div>

                        <div class="settingsFormGroup">
                            <label class="settingsLabel" for="settingsUsername">Kullanıcı Adı</label>
                            <input type="text" class="settingsInput" id="settingsUsername" value="<%= (typeof user !== 'undefined' && user && user.username) ? user.username : '' %>" placeholder="Kullanıcı adınızı girin">
                        </div>

                        <div class="settingsFormGroup">
                            <label class="settingsLabel" for="settingsEmail">E-posta Adresi</label>
                            <input type="email" class="settingsInput" id="settingsEmail" value="<%= (typeof user !== 'undefined' && user && user.email) ? user.email : '' %>" placeholder="E-posta adresiniz">
                        </div>

                        <div class="settingsActions">
                            <span class="settingsNoticeText" id="settingsNoticeText"></span>
                            <button type="button" class="settingsSaveBtn" id="settingsSaveBtn">Kaydet</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Kapalıyken Gösterilecek Açma Butonu Toggle -->
        <button class="sidebarOpenBtn" id="sidebarOpenBtn" title="Sidebar'ı Aç" aria-label="Sidebar'ı Aç">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <div class="sidebarBackdrop" id="sidebarBackdrop"></div>

        <!-- Ana Chat Alanı -->
        <main class="mainChat">
            <div class="chatContainer">
                
                <!-- 4. DİKEY VE YATAY ORTALANMIŞ KARŞILAMA EKRANI (Başlık + Alt Başlık + Input Tek Grup) -->
                <div class="welcomeCenteredGroup" id="welcomeCenteredGroup">
                    <div class="welcomeMascot">
                        <img src="/image/arfid_icon.png" alt="ARFID Asistanı" class="mascotIconImg">
                    </div>
                    <h1 class="welcomeHeroTitle">Hoşgeldiniz, <%= (typeof user !== 'undefined' && user && user.username) ? user.username : 'Kullanıcı' %></h1>
                    <p class="welcomeHeroSubtitle">Bugün beslenme yolculuğunda sana nasıl yardımcı olabilirim?</p>
                    
                    <!-- Karşılama Ekranındayken Input Bar Buraya Entegre Olur -->
                    <div class="messageInputContainer heroMode" id="messageInputContainer">
                        <div class="messageInputWrapper">
                            <input type="text" class="messageInput" id="messageInput" placeholder="Duygularınızı, tercihlerinizi veya sorularınızı yazın..." autocomplete="off">
                            <button class="sendButton" id="sendButton" title="Gönder" aria-label="Gönder">
                                <svg class="sendIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="19" x2="12" y2="5"></line>
                                    <polyline points="5 12 12 5 19 12"></polyline>
                                </svg>
                            </button>
                        </div>
                        <div class="inputHint">Asistanımız medikal tanı koymaz; ARFID rehberliği ve destek sunar.</div>
                    </div>
                </div>

                <!-- Chat Mesajları Akış Alanı (Mesajlar başlayınca görünür) -->
                <div class="chatArea" id="chatArea" style="display: none;">
                    <!-- Dinamik mesajlar buraya eklenecektir -->
                </div>
            </div>
        </main>
    </div>

    <script>
        // Sidebar Açma / Kapatma Mantığı (UI Katmanı)
        const sidebar = document.getElementById('sidebar');
        const sidebarCloseBtn = document.getElementById('sidebarCloseBtn');
        const sidebarOpenBtn = document.getElementById('sidebarOpenBtn');
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');
        const newChatBtn = document.getElementById('newChatBtn');
        
        const welcomeCenteredGroup = document.getElementById('welcomeCenteredGroup');
        const chatContainer = document.querySelector('.chatContainer');
        const messageInputContainer = document.getElementById('messageInputContainer');
        const chatArea = document.getElementById('chatArea');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');

        function openSidebar() {
            sidebar.classList.remove('collapsed');
            sidebarBackdrop.classList.add('active');
            sidebarOpenBtn.classList.remove('visible');
        }

        function closeSidebar() {
            sidebar.classList.add('collapsed');
            sidebarBackdrop.classList.remove('active');
            sidebarOpenBtn.classList.add('visible');
        }

        if (sidebarCloseBtn) {
            sidebarCloseBtn.addEventListener('click', closeSidebar);
        }
        if (sidebarOpenBtn) {
            sidebarOpenBtn.addEventListener('click', openSidebar);
        }
        if (sidebarBackdrop) {
            sidebarBackdrop.addEventListener('click', closeSidebar);
        }

        // ==========================================
        // AYARLAR (SETTINGS) MODAL ETKİLEŞİMİ
        // ==========================================
        const openSettingsBtn = document.getElementById('openSettingsBtn');
        const closeSettingsBtn = document.getElementById('closeSettingsBtn');
        const settingsModalOverlay = document.getElementById('settingsModalOverlay');
        const settingsModal = document.getElementById('settingsModal');
        const settingsSaveBtn = document.getElementById('settingsSaveBtn');
        const settingsNoticeText = document.getElementById('settingsNoticeText');

        function openSettingsModal() {
            if (settingsModalOverlay) {
                settingsModalOverlay.classList.add('active');
                if (settingsNoticeText) settingsNoticeText.textContent = '';
            }
        }

        function closeSettingsModal() {
            if (settingsModalOverlay) {
                settingsModalOverlay.classList.remove('active');
            }
        }

        if (openSettingsBtn) {
            openSettingsBtn.addEventListener('click', openSettingsModal);
        }
        if (closeSettingsBtn) {
            closeSettingsBtn.addEventListener('click', closeSettingsModal);
        }
        if (settingsModalOverlay) {
            settingsModalOverlay.addEventListener('click', function(e) {
                if (e.target === settingsModalOverlay) {
                    closeSettingsModal();
                }
            });
        }

        // Kaydet butonu (Backend güncelleme endpoint'i hazır olana kadar bilgilendirici UI bildirimi)
        if (settingsSaveBtn) {
            settingsSaveBtn.addEventListener('click', function() {
                if (settingsNoticeText) {
                    settingsNoticeText.textContent = 'Profil güncelleme özelliği henüz backend üzerinde aktif değildir.';
                    settingsNoticeText.style.color = '#FFA934';
                    setTimeout(() => {
                        if (settingsNoticeText) settingsNoticeText.textContent = '';
                    }, 4000);
                }
            });
        }

        // Karşılama Ekranı & Input Konum Durum Yönetimi (Boş/Dolu Sohbet)
        function checkWelcomeState() {
            const hasMessages = chatArea && chatArea.children.length > 0;
            if (hasMessages) {
                // Mesaj akış moduna geç: Ortalanmış karşılama grubunu gizle
                if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'none';
                if (chatArea) chatArea.style.display = 'flex';
                
                // Input barını chatContainer'ın altına taşı ve normal moda al
                if (messageInputContainer) {
                    messageInputContainer.classList.remove('heroMode');
                    chatContainer.appendChild(messageInputContainer);
                }
            } else {
                // Boş sohbet moduna geç: Ortalanmış grubu göster
                if (welcomeCenteredGroup) welcomeCenteredGroup.style.display = 'flex';
                if (chatArea) chatArea.style.display = 'none';
                
                // Input barını ortalanmış grubun içine geri taşı
                if (messageInputContainer && welcomeCenteredGroup) {
                    messageInputContainer.classList.add('heroMode');
                    welcomeCenteredGroup.appendChild(messageInputContainer);
                }
            }
        }

        // Sayfa açıldığında başlangıç durumunu kontrol et
        checkWelcomeState();

        // Yeni Sohbet Butonu: Mevcut chat alanını temizleyip ortalanmış hoşgeldin ekranını geri getirir
        if (newChatBtn) {
            newChatBtn.addEventListener('click', () => {
                finishActiveTyping();
                removeLoading();
                chatArea.innerHTML = '';
                checkWelcomeState();
                messageInput.value = '';
                messageInput.focus();
                // Mobilde sohbet başlatıldığında sidebar'ı kapat
                if (window.innerWidth <= 768) {
                    closeSidebar();
                }
            });
        }

        // ==========================================
        // MEVCUT MESAJLAŞMA & FONKSİYONEL JS MANTIĞI
        // ==========================================
        let currentLoadingBubble = null;
        let activeTypingInterval = null;
        let activeTypingBubble = null;
        let activeTypingFullText = '';
        const TYPING_SPEED_MS = 25; // 25ms per character / speed config

        function finishActiveTyping() {
            if (activeTypingInterval) {
                clearInterval(activeTypingInterval);
                activeTypingInterval = null;
            }
            if (activeTypingBubble && activeTypingFullText) {
                activeTypingBubble.textContent = activeTypingFullText;
                activeTypingBubble = null;
                activeTypingFullText = '';
            }
        }

        function showLoading() {
            if (currentLoadingBubble) return;

            const messageDiv = document.createElement('div');
            messageDiv.className = 'welcomeMessage';
            messageDiv.id = 'loadingIndicator';
            messageDiv.innerHTML = `
                <div class="aiAvatar">
                    <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                </div>
                <div class="aiMessageBubble aiLoadingBubble">
                    <div class="loadingBubble">
                        <span class="loadingText">Düşünüyor...</span>
                        <div class="typingDots">
                            <div class="dot"></div>
                            <div class="dot"></div>
                            <div class="dot"></div>
                        </div>
                    </div>
                </div>
            `;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
            currentLoadingBubble = messageDiv;
        }

        function removeLoading() {
            if (currentLoadingBubble) {
                currentLoadingBubble.remove();
                currentLoadingBubble = null;
            }
        }

        function addUserMessage(message) {
            finishActiveTyping();
            
            // İlk mesaj gönderildiğinde karşılama ekranını kaldır ve input'u alt konuma taşı
            if (welcomeCenteredGroup && welcomeCenteredGroup.style.display !== 'none') {
                welcomeCenteredGroup.style.display = 'none';
                chatArea.style.display = 'flex';
                messageInputContainer.classList.remove('heroMode');
                chatContainer.appendChild(messageInputContainer);
            }

            const messageDiv = document.createElement('div');
            messageDiv.className = 'userMessage';
            messageDiv.innerHTML = `
                <div class="userMessageBubble">
                    ${escapeHtml(message)}
                </div>
            `;
            chatArea.appendChild(messageDiv);
            chatArea.scrollTop = chatArea.scrollHeight;
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function addAiMessage(message) {
            removeLoading();
            finishActiveTyping();

            const messageDiv = document.createElement('div');
            messageDiv.className = 'welcomeMessage';
            const bubbleDiv = document.createElement('div');
            bubbleDiv.className = 'aiMessageBubble typingReveal';
            
            messageDiv.innerHTML = `
                <div class="aiAvatar">
                    <img src="/image/arfid_icon.png" class="aiAvatarIcon" alt="ARFID Asistanı">
                </div>
            `;
            messageDiv.appendChild(bubbleDiv);
            chatArea.appendChild(messageDiv);

            activeTypingBubble = bubbleDiv;
            activeTypingFullText = message;

            // Metni kelimelere böl: İlk 3-4 kelimeyi daktilo efektiyle yaz, ardından kalanı akıcı şekilde tamamla
            const words = message.trim().split(/\s+/);
            
            // Eğer mesaj çok kısaysa (<= 4 kelime) normal karakter karakter yazdır
            if (words.length <= 4) {
                let charIndex = 0;
                activeTypingInterval = setInterval(() => {
                    charIndex++;
                    bubbleDiv.textContent = message.substring(0, charIndex);
                    chatArea.scrollTop = chatArea.scrollHeight;

                    if (charIndex >= message.length) {
                        clearInterval(activeTypingInterval);
                        activeTypingInterval = null;
                        activeTypingBubble = null;
                        activeTypingFullText = '';
                    }
                }, TYPING_SPEED_MS);
                return;
            }

            // İlk 3 kelimenin bittiği karakter indeksini bul
            const firstWords = words.slice(0, 3).join(' ') + ' ';
            const targetCharCount = firstWords.length;
            let charIndex = 0;

            // 1. Aşama: İlk 3-4 kelimeyi hızlı ve canlı daktilo efektiyle yaz
            activeTypingInterval = setInterval(() => {
                charIndex += 2; // Akıcı ve seri başlangıç
                if (charIndex >= targetCharCount) {
                    clearInterval(activeTypingInterval);
                    activeTypingInterval = null;
                    
                    // 2. Aşama: İlk 3-4 kelimeden hemen sonra tüm cevabı şık ve profesyonel bir fade/slide geçişiyle göster
                    bubbleDiv.textContent = message;
                    bubbleDiv.classList.add('fadeContent');
                    chatArea.scrollTop = chatArea.scrollHeight;

                    activeTypingBubble = null;
                    activeTypingFullText = '';
                } else {
                    bubbleDiv.textContent = message.substring(0, charIndex);
                    chatArea.scrollTop = chatArea.scrollHeight;
                }
            }, TYPING_SPEED_MS);
        }

        async function sendMessage() {
            const message = messageInput.value.trim();
            if (message) {
                // Disable UI to prevent spam
                sendButton.disabled = true;
                messageInput.disabled = true;

                addUserMessage(message);
                messageInput.value = '';
                showLoading();

                try {
                    const response = await fetch('/chat', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ message })
                    });
                    
                    if (response.ok) {
                        const data = await response.json();
                        addAiMessage(data.response);
                    } else {
                        const data = await response.json().catch(() => ({}));
                        addAiMessage(data.error || "Üzgünüm, şu an cevap veremiyorum. (Sunucu hatası)");
                    }
                } catch (error) {
                    console.error('Chat error:', error);
                    addAiMessage("Bağlantı hatası oluştu. Lütfen sunucuyu kontrol edin.");
                } finally {
                    // Re-enable UI regardless of success or error
                    sendButton.disabled = false;
                    messageInput.disabled = false;
                    messageInput.focus();
                }
            }
        }

        sendButton.addEventListener('click', sendMessage);
        messageInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });
    </script>
</body>
</html>