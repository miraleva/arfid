# Google Gemini AI API Anahtarı (Metin ve chatbot yanıt üretimi için)
GOOGLE_API_KEY=

# İç Servis Güvenlik Anahtarı (Backend ve yetkili çağrılar arası güvenli doğrulama jetonu)
INTERNAL_SHARED_SECRET=

# Pinecone Vektör Veritabanı API Anahtarı (RAG arama ve embedding depolama için)
PINECONE_API_KEY=

# Pinecone Indeks Adı (RAG verilerinin saklandığı vektör indeks başlığı)
PINECONE_INDEX_NAME=

# RAG Retrieval FastAPI Servis Adresi
RAG_SERVICE_URL=http://localhost:5001

# Geliştirici ve Manuel Test Endpoint'leri Güvenlik Jetonu (/dev/* için X-Dev-Token)
DEV_TEST_TOKEN=your_dev_test_token_here
